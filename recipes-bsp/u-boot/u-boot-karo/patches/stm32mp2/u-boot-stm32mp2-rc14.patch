+static const struct detect_info_t stm32mp25x_bridges[] = {
+	{
+		.detect = detect_stm32mp25x_adv753x,
+		.compatible = "adi,adv7533",
+	},
+	{
+		.detect = detect_stm32mp25x_adv753x,
+		.compatible = "adi,adv7535",
+	},
+};
