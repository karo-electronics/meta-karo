Index: u-boot-txmp-2550/Makefile
===================================================================
--- u-boot-txmp-2550.orig/Makefile
+++ u-boot-txmp-2550/Makefile
@@ -3,7 +3,7 @@
 VERSION = 2022
 PATCHLEVEL = 10
 SUBLEVEL =
-EXTRAVERSION = -stm32mp-r1.1
+EXTRAVERSION = -stm32mp-r2-rc16
 NAME =
 
 # *DOCUMENTATION*
@@ -483,6 +483,11 @@ export RCS_FIND_IGNORE := \( -name SCCS
 export RCS_TAR_IGNORE := --exclude SCCS --exclude BitKeeper --exclude .svn \
 			 --exclude CVS --exclude .pc --exclude .hg --exclude .git
 
+# handle external device tree
+
+EXT_DTS ?= $(srctree)/arch/$(ARCH)/dts/external-dt/u-boot
+export EXT_DTS
+
 # ===========================================================================
 # Rules shared between *config targets and build targets
 
@@ -1858,9 +1863,7 @@ include/generated/env.txt: $(wildcard $(
 # Write out the resulting environment, converted to a C string
 quiet_cmd_gen_envt = ENVT    $@
       cmd_gen_envt = \
-	awk -f $(srctree)/scripts/env2string.awk $< > $@.tmp; \
-	[ -e $@ ] && cmp -s $@ $@.tmp && rm $@.tmp; \
-	! [ -e $@.tmp ] || mv $@.tmp $@
+	awk -f $(srctree)/scripts/env2string.awk $< >$@
 $(env_h): include/generated/env.in
 	$(call cmd,gen_envt)
 
