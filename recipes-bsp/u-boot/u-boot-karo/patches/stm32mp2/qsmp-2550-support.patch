Index: u-boot-qsmp-2550/board/karo/common/Kconfig
===================================================================
--- u-boot-qsmp-2550.orig/board/karo/common/Kconfig
+++ u-boot-qsmp-2550/board/karo/common/Kconfig
@@ -90,6 +90,15 @@ config KARO_QSMP_1351
 	  an STM32MP135C SOC, 256MiB of SDRAM and 4GiB eMMC on a solder-in
 	  module.
 
+config KARO_QSMP_2550
+	bool "Ka-Ro QSMP-2550 module"
+	depends on TARGET_KARO_STM32MP2
+	select KARO_STM32
+	imply KARO_STM32_EMMC
+	help
+	  Enable support for the Ka-Ro electronics QSMP-2550 module featuring
+	  an STM32MP255F SOC, 1GiB of SDRAM and 4GiB eMMC.
+
 config KARO_TXMP_2550
 	bool "Ka-Ro TXMP-2550 module"
 	depends on TARGET_KARO_STM32MP2
