-		     PWR_MPUCR_CSSF | PWR_MPUCR_CSTDBYDIS | PWR_MPUCR_PDDS);
-
-	saved_mcudivr = readl(STM32_RCC_BASE + RCC_MCUDIVR);
-	saved_pll3cr = readl(STM32_RCC_BASE + RCC_PLL3CR);
-	saved_pll4cr = readl(STM32_RCC_BASE + RCC_PLL4CR);
