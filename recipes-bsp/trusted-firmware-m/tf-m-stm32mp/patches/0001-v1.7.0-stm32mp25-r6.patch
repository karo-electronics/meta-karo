+ *     a {
+ *             compatible = "vnd,device";
+ *             status = "okay";
+ *             foobar = "DEV_A";
+ *     };
+ *
+ *     b {
+ *             compatible = "vnd,device";
+ *             status = "okay";
+ *             foobar = "DEV_B";
