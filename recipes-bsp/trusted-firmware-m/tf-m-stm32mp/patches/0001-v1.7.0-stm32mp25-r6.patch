+def test_string_parsing():
+    '''Properties with string values'''
+
+    verify_parse(r"""
+/dts-v1/;
+
+/ {
+	a = "";
+	b = "ABC";
+	c = "\\\"\xab\377\a\b\t\n\v\f\r";
+};
+""",
+r"""
+/dts-v1/;
+
+/ {
+	a = "";
+	b = "ABC";
+	c = "\\\"\xab\xff\a\b\t\n\v\f\r";
+};
