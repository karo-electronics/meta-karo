+ *     };
+ * @endcode
+ *
+ * This expands as a first step to:
+ *
+ * @code{.c}
+ *     struct gpio_dt_spec specs[] = {
+ *     struct gpio_dt_spec specs[] = {
+ *             GPIO_DT_SPEC_GET_BY_IDX(DT_NODELABEL(n), my_gpios, 0),
