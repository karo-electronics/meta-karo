+#define DT_INST_PARENT(inst) DT_PARENT(DT_DRV_INST(inst))
+
+/**
+ * @brief Get a `DT_DRV_COMPAT` grandparent's node identifier
+ * @param inst instance number
+ * @return a node identifier for the instance's grandparent
