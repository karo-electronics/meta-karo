+#define FLASH_RETRAM_SECTOR_SIZE	(0x0000100)	/* 256 B */
+#define FLASH_RETRAM_PROGRAM_UNIT	(0x1)		/* Minimum write size */
+
+#define STM32_FLASH_BKPSRAM
