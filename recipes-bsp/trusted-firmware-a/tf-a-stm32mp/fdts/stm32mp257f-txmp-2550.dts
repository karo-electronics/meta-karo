/* For more information on Device Tree configuration, please refer to
 * https://wiki.st.com/stm32mpu/wiki/Category:Device_tree_configuration
 */

/dts-v1/;

#include "stm32mp257.dtsi"
#include "stm32mp25xf.dtsi"
#include "stm32mp257f-txmp-2550-rcc.dtsi"
#include "stm32mp257f-txmp-ddr.h"
#include "stm32mp25-ddr.dtsi"
#include "stm32mp25xxai-pinctrl.dtsi"
#include <dt-bindings/pinctrl/stm32-pinfunc.h>

/ {
	model = "Ka-Ro electronics GmbH TXMP-2550 module";
	compatible = "st,stm32mp257f-txmp-2550", "st,stm32mp257";

	aliases {
		serial0 = &usart2;
		serial1 = &usart1;
		serial2 = &uart7;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00000000 0x80000000 0x00000000 0x40000000>;
	};
};

&bsec {
	status = "okay";
};

&ddr {
	vdd1-supply = <&vdd1_ddr>;
	vdd2-supply = <&vddq_ddr>;
	vddq-supply = <&vddq_ddr>;
};

&hash {
	status = "okay";
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins>;
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;
	clock-frequency = <400000>;
	status = "okay";

	pmic2: stpmic@33 {
		compatible = "st,stpmic2";
		reg = <0x33>;
		status = "okay";

		regulators {
			compatible = "st,stpmic2-regulators";

			vddcpu: buck1 {
				regulator-name = "vddcpu";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <910000>;
				regulator-always-on;
			};

			vddcore: buck2 {
				regulator-name = "vddcore";
				regulator-min-microvolt = <820000>;
				regulator-max-microvolt = <820000>;
				regulator-always-on;
			};

			vddgpu: buck3 {
				regulator-name = "vddgpu";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <900000>;
			};

			vddio_pmic: buck4 {
				regulator-name = "vddio";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			v1v8: buck5 {
				regulator-name = "v1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			vddq_ddr: buck6 {
				regulator-name = "vddq_ddr";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
			};

			v3v3: buck7 {
				regulator-name = "v3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vdda1v8_aon: ldo1 {
				regulator-name = "vdda1v8_aon";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			vdd_emmc: ldo2 {
				regulator-name = "vdd_emmc";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vdd1_ddr: ldo3 {
				regulator-name = "vdd1ddr";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-enable-ramp-delay = <1000>;
			};

			vdd3v3_usb: ldo4 {
				regulator-name = "vdd3v3_usb";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vddio_sdcard: ldo8 {
				regulator-name = "vddio_sdcard";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
		};
	};
};

&pwr {
	pinctrl-names = "default";
	pinctrl-0 = <&wakeup_pins>;
};

&rcc {
	status = "okay";
};

&rng {
	status = "okay";
};

&saes {
	status = "okay";
};

&sdmmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_pins>;
	vmmc-supply = <&v3v3>;
	vqmmc-supply = <&vddio1>;
	st,neg-edge;
	bus-width = <4>;
	status = "okay";
};

&sdmmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2_pins>;
	vmmc-supply = <&vdd_emmc>;
	vqmmc-supply = <&vddio2>;
	non-removable;
	no-sd;
	no-sdio;
	st,neg-edge;
	bus-width = <8>;
	status = "okay";
};

&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart7_pins &uart7_rtscts_pins>;
	status = "okay";
};

&usart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&usart1_pins &usart1_rtscts_pins>;
	status = "okay";
};

&usart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&usart2_pins &usart2_rtscts_pins>;
	status = "okay";
};

&vddio1 {
	vddio1-supply = <&vddio_sdcard>;
};

&vddio2 {
	vddio2-supply = <&v1v8>;
};

&vddio3 {
	vddio3-supply = <&vddio_pmic>;
};

&vddio4 {
	vddio4-supply = <&vddio_pmic>;
};

&vddio {
	vdd-supply = <&vddio_pmic>;
};

&pinctrl {
	i2c7_pins: i2c7-pins {
		pins1 {
			pinmux = <STM32_PINMUX('H', 3, AF10)>, /* I2C7_SCL */
				 <STM32_PINMUX('D', 14, AF10)>; /* I2C7_SDA */
			bias-disable;
			drive-open-drain;
			slew-rate = <0>;
		};
	};

	sdmmc1_pins: sdmmc1-pins {
		pins1 {
			pinmux = <
				  STM32_PINMUX('E', 4, AF10) /* SDMMC1_D0 */
				  STM32_PINMUX('E', 5, AF10) /* SDMMC1_D1 */
				  STM32_PINMUX('E', 0, AF10) /* SDMMC1_D2 */
				  STM32_PINMUX('E', 1, AF10) /* SDMMC1_D3 */
				  STM32_PINMUX('E', 2, AF10) /* SDMMC1_CMD */
			>;
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('E', 3, AF10)>; /* SDMMC1_CK */
			bias-disable;
			drive-push-pull;
			slew-rate = <3>;
		};
	};

	sdmmc2_pins: sdmmc2-pins {
		pins1 {
			pinmux = <
				  STM32_PINMUX('E', 13, AF12)	/* SDMMC2_D0 */
				  STM32_PINMUX('E', 11, AF12)	/* SDMMC2_D1 */
				  STM32_PINMUX('E', 8, AF12)	/* SDMMC2_D2 */
				  STM32_PINMUX('E', 12, AF12)	/* SDMMC2_D3 */
				  STM32_PINMUX('E', 10, AF12)	/* SDMMC2_D4 */
				  STM32_PINMUX('E', 9, AF12)	/* SDMMC2_D5 */
				  STM32_PINMUX('E', 6, AF12)	/* SDMMC2_D6 */
				  STM32_PINMUX('E', 7, AF12)	/* SDMMC2_D7 */
				  STM32_PINMUX('E', 15, AF12)	/* SDMMC2_CMD */
			>;
			bias-disable;
			drive-push-pull;
			slew-rate = <1>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('E', 14, AF12)>; /* SDMMC2_CK */
			bias-disable;
			drive-push-pull;
			slew-rate = <3>;
		};
	};

	uart7_pins: uart7-pins {
		pins1 {
			pinmux = <STM32_PINMUX('D', 3, AF6)>; /* UART7_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('D', 0, AF6)>; /* UART7_RX */
			bias-pull-up;
		};
	};

	uart7_rtscts_pins: uart7-rtscts-pins {
		pins1 {
			pinmux = <STM32_PINMUX('D', 1, AF6)>; /* UART7_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('D', 2, AF6)>; /* UART7_CTS_NSS */
			bias-pull-up;
		};
	};

	usart1_pins: usart1-pins {
		pins1 {
			pinmux = <STM32_PINMUX('B', 8, AF6)>; /* USART1_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('B', 10, AF6)>; /* USART1_RX */
			bias-pull-up;
		};
	};

	usart1_rtscts_pins: usart1-rtscts-pins {
		pins1 {
			pinmux = <STM32_PINMUX('B', 9, AF6)>; /* USART1_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('I', 3, AF6)>; /* USART1_CTS_NSS */
			bias-pull-up;
		};
	};

	usart2_pins: usart2-pins {
		pins1 {
			pinmux = <STM32_PINMUX('A', 4, AF6)>; /* USART2_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('A', 8, AF8)>; /* USART2_RX */
			bias-pull-up;
		};
	};

	usart2_rtscts_pins: usart2-rtscts-pins {
		pins1 {
			pinmux = <STM32_PINMUX('A', 5, AF6)>; /* USART2_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('A', 9, AF6)>; /* USART2_CTS_NSS */
			bias-pull-up;
		};
	};

	wakeup_pins: wakeup-pins {
		pins {
			pinmux = <
				  STM32_PINMUX('A', 0, ANALOG) /* PWR_WKUP1 */
			>;
		};
	};
};
