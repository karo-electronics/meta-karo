From 11b9a9438b28e560f2682c4719e12f558f820277 Mon Sep 17 00:00:00 2001
From: Robin Lintermann <rl@karo-electronics.de>
Date: Wed, 9 Sep 2026 09:16:35 +0000
Subject: [PATCH] fix(stm32mp2): standardize OTP node names from underscores to
 dashes

- Update OTP definitions in stm32mp2_def.h from part_number_otp to part-number-otp, etc.
- Add legacy OTP definitions (_LEGACY suffix) for backward compatibility
- Add find_legacy_node_name() in stm32mp_dt.c to handle both naming conventions
- Update error messages in dt_find_otp_name() to be less severe for missing nodes
- Also includes memory unit standardization (KB to KiB) in stm32mp2_def.h

This ensures compatibility with both legacy DTBs using underscores and new
standard DTBs using dashes for OTP node names.

Generated by Mistral Vibe.
Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 plat/st/common/stm32mp_dt.c     | 54 ++++++++++++++++++++++-----------
 plat/st/stm32mp2/stm32mp2_def.h | 46 ++++++++++++++++------------
 2 files changed, 63 insertions(+), 37 deletions(-)

diff --git a/plat/st/common/stm32mp_dt.c b/plat/st/common/stm32mp_dt.c
index 7f0fffff6..2a78aac85 100644
--- a/plat/st/common/stm32mp_dt.c
+++ b/plat/st/common/stm32mp_dt.c
@@ -6,15 +6,14 @@
 
 #include <assert.h>
 #include <errno.h>
-
+#include <libfdt.h>
+#include <platform_def.h>
+#include <stm32mp_dt.h>
+#include <string.h>
 #include <common/debug.h>
 #include <common/fdt_wrappers.h>
 #include <drivers/st/regulator.h>
 #include <drivers/st/stm32_gpio.h>
-#include <libfdt.h>
-
-#include <platform_def.h>
-#include <stm32mp_dt.h>
 
 static void *fdt;
 
@@ -27,9 +26,8 @@ int dt_open_and_check(uintptr_t dt_addr)
 	int ret;
 
 	ret = fdt_check_header((void *)dt_addr);
-	if (ret == 0) {
+	if (ret == 0)
 		fdt = (void *)dt_addr;
-	}
 
 	return ret;
 }
@@ -41,9 +39,8 @@ int dt_open_and_check(uintptr_t dt_addr)
  ******************************************************************************/
 int fdt_get_address(void **fdt_addr)
 {
-	if (fdt == NULL) {
+	if (fdt == NULL)
 		return 0;
-	}
 
 	*fdt_addr = fdt;
 
@@ -343,6 +340,26 @@ const char *dt_get_board_model(void)
 	return (const char *)fdt_getprop(fdt, node, "model", NULL);
 }
 
+static int find_legacy_node_name(const char *name, int node)
+{
+	int ret;
+	char legacy_name[42];
+	char *l;
+
+	if (strlen(name) >= sizeof(legacy_name))
+		return -FDT_ERR_NOTFOUND;
+
+	strlcpy(legacy_name, name, sizeof(legacy_name));
+	for (l = legacy_name; *l != '\0'; l++)
+		if (*l == '-')
+			*l = '_';
+	ret = fdt_subnode_offset(fdt, node, legacy_name);
+	if (ret == 0)
+		WARN("Found legacy property '%s' in DTB; please convert to: '%s'\n",
+		     legacy_name, name);
+	return ret;
+}
+
 /*******************************************************************************
  * dt_find_otp_name: get OTP ID and length in DT.
  * name: sub-node name to look up.
@@ -352,24 +369,27 @@ const char *dt_get_board_model(void)
  ******************************************************************************/
 int dt_find_otp_name(const char *name, uint32_t *otp, uint32_t *otp_len)
 {
+	int ret;
 	int node;
 	int len;
 	const fdt32_t *cuint;
 
-	if ((name == NULL) || (otp == NULL)) {
+	if ((name == NULL) || (otp == NULL))
 		return -FDT_ERR_BADVALUE;
-	}
 
 	node = fdt_node_offset_by_compatible(fdt, -1, DT_BSEC_COMPAT);
-	if (node < 0) {
+	if (node < 0)
 		return node;
-	}
 
-	node = fdt_subnode_offset(fdt, node, name);
-	if (node < 0) {
-		ERROR("nvmem node %s not found\n", name);
-		return node;
+	ret = fdt_subnode_offset(fdt, node, name);
+	if (ret < 0)
+		ret = find_legacy_node_name(name, node);
+
+	if (ret < 0) {
+		INFO("nvmem node %s not found\n", name);
+		return ret;
 	}
+	node = ret;
 
 	cuint = fdt_getprop(fdt, node, "reg", &len);
 	if ((cuint == NULL) || (len != (2 * (int)sizeof(uint32_t)))) {
