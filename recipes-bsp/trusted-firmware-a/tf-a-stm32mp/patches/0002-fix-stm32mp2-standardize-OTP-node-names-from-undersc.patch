+#define STM32MP_BL2_RO_SIZE			U(0x00021000)	/* 132 KiB */
+#define STM32MP_BL2_SIZE			U(0x0002C000)	/* 176 KiB for BL2 */
 #endif /* STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER */
 #else
