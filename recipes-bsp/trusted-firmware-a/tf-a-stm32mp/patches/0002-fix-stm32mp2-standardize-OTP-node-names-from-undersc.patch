+#define MAX_XLAT_TABLES				U(4)	/* 16 KiB for mapping */
 
 /*
  * MAX_MMAP_REGIONS is usually:
@@ -270,7 +270,7 @@ enum ddr_type {
 #endif
 
 /* DTB initialization value */
-#define STM32MP_BL2_DTB_SIZE			U(0x00006000)	/* 24 KB for DTB */
