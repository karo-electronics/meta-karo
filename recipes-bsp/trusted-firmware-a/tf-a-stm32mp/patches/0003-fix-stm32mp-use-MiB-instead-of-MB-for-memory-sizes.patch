From 9b9f28451ba371feb360ad78453d8b315e3d758d Mon Sep 17 00:00:00 2001
From: Robin Lintermann <rl@karo-electronics.de>
Date: Wed, 9 Sep 2026 09:16:38 +0000
Subject: [PATCH] fix(stm32mp): use MiB instead of MB for memory sizes

- Change memory size logging from MB to MiB (mebibytes) in DDR drivers
  for STM32MP1 and STM32MP2 platforms

This improves technical accuracy since the firmware uses binary multiples
(1024-based) not decimal multiples (1000-based).

Generated by Mistral Vibe.
Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 drivers/st/ddr/stm32mp1_ram.c | 2 +-
 drivers/st/ddr/stm32mp2_ram.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/st/ddr/stm32mp1_ram.c b/drivers/st/ddr/stm32mp1_ram.c
index 3e9571217..ad1e0fa73 100644
--- a/drivers/st/ddr/stm32mp1_ram.c
+++ b/drivers/st/ddr/stm32mp1_ram.c
@@ -148,7 +148,7 @@ static int stm32mp1_ddr_setup(void)
 			panic();
 		}
 
-		INFO("Memory size = 0x%zx (%zu MB)\n", retsize, retsize / (1024U * 1024U));
+		INFO("Memory size = 0x%zx (%zu MiB)\n", retsize, retsize / (1024U * 1024U));
 	}
 
 	/*
diff --git a/drivers/st/ddr/stm32mp2_ram.c b/drivers/st/ddr/stm32mp2_ram.c
index e37594d2c..eac8610fc 100644
--- a/drivers/st/ddr/stm32mp2_ram.c
+++ b/drivers/st/ddr/stm32mp2_ram.c
@@ -166,7 +166,7 @@ static int stm32mp2_ddr_setup(void)
 			panic();
 		}
 
-		INFO("Memory size = 0x%zx (%zu MB)\n", retsize, retsize / (1024U * 1024U));
+		INFO("Memory size = 0x%zx (%zu MiB)\n", retsize, retsize / (1024U * 1024U));
 	}
 
 	/*
