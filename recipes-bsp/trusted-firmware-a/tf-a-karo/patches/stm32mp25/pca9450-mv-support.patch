--- /dev/null
+++ tf-a-qsmp-2550/drivers/st/pmic/pca9450.c
@@ -0,0 +1,346 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2024 Lothar Waßmann <LW@KARO-electronics.de>
+ * based on:
+ *     drivers/st/pmic/stpmic2.c
+ *         Copyright (C) 2023, STMicroelectronics - All Rights Reserved
+ */
+
+#include <assert.h>
+#include <errno.h>
+#include <string.h>
+#include <common/debug.h>
+#include "pca9450.h"
+
+#define RET_SUCCESS			0
+#define RET_ERROR_NOT_SUPPORTED		-1
+#define RET_ERROR_GENERIC		-2
+#define RET_ERROR_BAD_PARAMETERS	-3
+
+#define I2C_TIMEOUT_MS			25
+
+#define VOLTAGE_INDEX_INVALID		((size_t)~0)
+
+static const struct regulator_limits {
+       uint16_t min;
+       uint16_t max;
+       uint16_t step;
+       uint8_t mask;
+} pca9450_regulator_limits[] = {
+	{  6000, 21875,  125, 0x7f, }, /* BUCK[1..3] */
+	{  6000, 34000,  250, 0x7f, }, /* BUCK[4..6] */
+	{ 16000, 33000, 1000, 0x07, }, /* LDO[1] */
+	{  8000, 11500,  500, 0x1f, }, /* LDO[2] */
+	{  8000, 33000, 1000, 0x1f, }, /* LDO[3..4] */
+	{ 18000, 33000, 1000, 0x0f, }, /* LDO[5] */
+};
+
+struct regul_struct {
+	const char *name;
+	size_t limits;
+	uint16_t *volt_table;
+	uint16_t volt_cr;
+	uint16_t en_cr;
+	uint16_t pd_reg;
+	uint8_t en_mask;
+	uint8_t pd_val;
+};
+
+#define DEFINE_BUCK(_index, _limits, _volt_cr) {		\
+	.name			= "buck" # _index,		\
+	.en_cr			= BUCK ## _index ## CTRL,	\
+	.en_mask		= BUCK_ENMODE,			\
+	.volt_cr		= BUCK ## _index ## _volt_cr,	\
+	.limits			= _limits,			\
+	.pd_reg			= BUCK ## _index ## CTRL,	\
+	.pd_val			= BUCK_AD_BIT,			\
+}
+
+#define DEFINE_LDO(_index, _limits) {				\
+	.name			= "ldo" # _index,		\
+	.en_cr			= LDO ## _index ## CTRL,	\
+	.en_mask		= LDO_ENMODE,		\
+	.volt_cr		= LDO ## _index ## CTRL,	\
+	.limits			= _limits,			\
+	.pd_reg			= LDO_AD_CTRL,			\
+	.pd_val			= LDO ## _index ## _AD_BIT,	\
+}
+
+static uint16_t buck123_volt_tables[128];
+static uint16_t buck456_volt_tables[128];
+static uint16_t ldo1_volt_table[8] = {
+	1600,
+	1700,
+	1800,
+	1900,
+	3000,
+	3100,
+	3200,
+	3300,
+};
+
+static uint16_t ldo2_volt_table[32];
+static uint16_t ldo34_volt_table[32];
+static uint16_t ldo5_volt_table[16];
+static uint16_t *volt_tables[] = {
+	buck123_volt_tables,
+	buck456_volt_tables,
+	ldo1_volt_table,
+	ldo2_volt_table,
+	ldo34_volt_table,
+	ldo5_volt_table,
+};
+
+/* Table of Regulators in PMIC SoC */
+static struct regul_struct regul_table[] = {
+	[PCA9450_BUCK1] = DEFINE_BUCK(1, 0, OUT_DVS0),
+	[PCA9450_BUCK2] = DEFINE_BUCK(2, 0, OUT_DVS0),
+	[PCA9450_BUCK3] = DEFINE_BUCK(3, 0, OUT_DVS0),
+	[PCA9450_BUCK4] = DEFINE_BUCK(4, 1, OUT),
+	[PCA9450_BUCK5] = DEFINE_BUCK(5, 1, OUT),
+	[PCA9450_BUCK6] = DEFINE_BUCK(6, 1, OUT),
+	[PCA9450_LDO1] = DEFINE_LDO(1, 2),
+	[PCA9450_LDO2] = DEFINE_LDO(2, 3),
+	[PCA9450_LDO3] = DEFINE_LDO(3, 4),
+	[PCA9450_LDO4] = DEFINE_LDO(4, 4),
+	[PCA9450_LDO5] = DEFINE_LDO(5, 5),
+};
+
+static inline const struct regulator_limits *get_limits(const struct regul_struct *regul)
+{
+	return &pca9450_regulator_limits[regul->limits];
+}
+
+static uint8_t mv_to_regval(const struct regulator_limits *limits, uint16_t mv)
+{
+	return (mv * 10 - limits->min) / limits->step;
+}
+
+static uint16_t regval_to_mv(const struct regulator_limits *limits, uint8_t regval)
+{
+	uint16_t mv = (regval & limits->mask) * limits->step + limits->min;
+
+	if (mv > limits->max)
+		mv = limits->max;
+	return mv / 10;
+}
+
+void pca9450_init(void)
+{
+	size_t id;
+
+	for (id = 0; id < ARRAY_SIZE(regul_table); id++) {
+		struct regul_struct *regul = &regul_table[id];
+		const struct regulator_limits *limits = get_limits(regul);
+		size_t num_voltages = limits->mask + 1;
+		size_t idx;
+
+		regul->volt_table = volt_tables[regul->limits];
+
+		for (idx = 0; idx < num_voltages; idx++) {
+			/* skip tables that have already been set up */
+			if (!regul->volt_table[idx]) {
+				int ret;
+
+				ret = regval_to_mv(limits, idx);
+				if (ret < 0) {
+					ERROR("Regulator reg value %08zx out of range 0..%u\n",
+					      idx, limits->mask + 1U);
+					panic();
+				}
+				if ((uint16_t)ret > limits->max)
+					regul->volt_table[idx] = limits->max;
+				else
+					regul->volt_table[idx] = ret;
+			}
+			VERBOSE("%s@%d: %s[%zu]=%u.%03umV\n", __func__, __LINE__,
+				regul->name, idx, regul->volt_table[idx] / 1000U,
+				regul->volt_table[idx] % 1000U);
+		}
+	}
+}
+
+int pca9450_register_read(struct pmic_handle_s *pmic,
+			  uint16_t register_id, uint8_t *value)
+{
+	int ret = stm32_i2c_mem_read(pmic->i2c_handle,
+				     pmic->i2c_addr,
+				     register_id,
+				     I2C_MEMADD_SIZE_8BIT, value,
+				     1, I2C_TIMEOUT_MS);
+	if (ret)
+		ERROR("Failed to read reg:0x%x\n", register_id);
+
+	return ret;
+}
+
+int pca9450_register_write(struct pmic_handle_s *pmic,
+			   uint16_t register_id, uint8_t value)
+{
+	uint8_t val = value;
+	int ret = stm32_i2c_mem_write(pmic->i2c_handle,
+				      pmic->i2c_addr,
+				      register_id,
+				      I2C_MEMADD_SIZE_8BIT, &val,
+				      1, I2C_TIMEOUT_MS);
+	if (ret)
+		ERROR("Failed to write reg:0x%x\n", register_id);
+
+	return ret;
+}
+
+int pca9450_register_update(struct pmic_handle_s *pmic,
+			    uint16_t register_id, uint8_t newval, uint8_t mask)
+{
+	int status;
+	uint8_t val;
+	uint8_t clr = ~mask;
+
+	status = pca9450_register_read(pmic, register_id, &val);
+	if (status)
+		return status;
+
+	val = (val & clr) | (newval & mask);
+	return pca9450_register_write(pmic, register_id, val);
+}
+
+int pca9450_regulator_set_state(struct pmic_handle_s *pmic,
+				uint8_t id, bool enable)
+{
+	const struct regul_struct *regul = &regul_table[id];
+
+	return pca9450_register_update(pmic, regul->en_cr,
+				       enable ? regul->en_mask : 0,
+				       regul->en_mask);
+}
+
+int pca9450_regulator_get_state(struct pmic_handle_s *pmic,
+				uint8_t id, bool *enabled)
+{
+	const struct regul_struct *regul = &regul_table[id];
+	uint8_t val;
+
+	if (pca9450_register_read(pmic, regul->en_cr, &val))
+		return RET_ERROR_GENERIC;
+
+	*enabled = !!(val & regul->en_mask);
+
+	return RET_SUCCESS;
+}
+
+int pca9450_regulator_levels_mv(struct pmic_handle_s *pmic,
+				uint8_t id, const uint16_t **levels,
+				size_t *levels_count)
+{
+	const struct regul_struct *regul = &regul_table[id];
+	const struct regulator_limits *limits = get_limits(regul);
+	size_t num_voltages = limits->mask + 1;
+
+	if (levels_count)
+		*levels_count = num_voltages;
+
+	if (levels != NULL)
+		*levels = regul->volt_table;
+
+	return RET_SUCCESS;
+}
+
+int pca9450_regulator_get_voltage(struct pmic_handle_s *pmic,
+				  uint8_t id, uint16_t *val)
+{
+	const struct regul_struct *regul = &regul_table[id];
+	const struct regulator_limits *limits = get_limits(regul);
+	uint8_t value;
+
+	if (pca9450_register_read(pmic, regul->volt_cr, &value))
+		return RET_ERROR_GENERIC;
+
+	*val = regval_to_mv(limits, value);
+	return RET_SUCCESS;
+}
+
+int pca9450_regulator_set_voltage(struct pmic_handle_s *pmic,
+				  uint8_t id, uint16_t mv)
+{
+	const struct regul_struct *regul = &regul_table[id];
+	const struct regulator_limits *limits = get_limits(regul);
+	uint8_t regval;
+
+	INFO("%s@%d: Setting %s voltage to %umV\n", __func__, __LINE__,
+	     regul->name, mv);
+
+	if (mv * 10 > limits->max)
+		return RET_ERROR_GENERIC;
+
+	regval = mv_to_regval(limits, mv);
+	return pca9450_register_update(pmic, regul->volt_cr, regval, limits->mask);
+}
+
+int pca9450_regulator_get_prop(struct pmic_handle_s *pmic, size_t id,
+			       enum pca9450_prop_id prop)
+{
+	int ret;
+	const struct regul_struct *regul = &regul_table[id];
+	uint8_t val;
+
+	VERBOSE("%s: get prop 0x%x\n", regul->name, prop);
+
+	switch (prop) {
+	case PCA9450_PULL_DOWN:
+		ret = pca9450_register_read(pmic, regul->pd_reg, &val);
+		if (ret)
+			return ret;
+		return !!(val & regul->pd_val);
+
+	default:
+		ERROR("%s(%s): Invalid prop %u\n", __func__, regul->name, prop);
+		panic();
+	}
+}
+
+int pca9450_regulator_set_prop(struct pmic_handle_s *pmic, size_t id,
+			       enum pca9450_prop_id prop, uint32_t arg)
+{
+	const struct regul_struct *regul = &regul_table[id];
+
+	VERBOSE("%s: set prop 0x%x arg=%u\n", regul->name, prop, arg);
+
+	switch (prop) {
+	case PCA9450_PULL_DOWN:
+		return pca9450_register_update(pmic, regul->pd_reg,
+					       arg ? regul->pd_val : 0,
+					       regul->pd_val);
+	default:
+		ERROR("Invalid prop %u\n", prop);
+		panic();
+	}
+}
+
+#if EVENT_LOG_LEVEL == LOG_LEVEL_NOTICE
+void pca9450_dump_regulators(struct pmic_handle_s *pmic)
+{
+	size_t i;
+	char const *name;
+
+	for (i = 0; i < ARRAY_SIZE(regul_table); i++) {
+		uint16_t val;
+		bool state;
+
+		if (!regul_table[i].volt_cr)
+			continue;
+
+		pca9450_regulator_get_voltage(pmic, i, &val);
+		pca9450_regulator_get_state(pmic, i, &state);
+
+		name = regul_table[i].name;
+
+		NOTICE("PMIC regul %s: %s, %umV\n",
+		       name, state ? "EN" : "DIS", val);
+	}
+}
+#endif
+
+int pca9450_get_chip_id(struct pmic_handle_s *pmic, uint8_t *val)
+{
+	return pca9450_register_read(pmic, DEVICE_ID, val);
+}
