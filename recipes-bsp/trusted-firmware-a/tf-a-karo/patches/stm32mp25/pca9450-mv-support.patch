--- /dev/null
+++ tf-a-qsmp-2550/drivers/st/pmic/pmic-pca9450.c
@@ -0,0 +1,410 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2024 Lothar Waßmann <LW@KARO-electronics.de>
+ * based on:
+ *     drivers/st/pmic/stm32mp2_pmic2.c
+ *         Copyright (C) 2023, STMicroelectronics - All Rights Reserved
+ *
+ */
+
+#include <assert.h>
+#include <errno.h>
+#include <libfdt.h>
+#include <platform_def.h>
+#include <common/debug.h>
+#include <drivers/delay_timer.h>
+#include <drivers/st/regulator.h>
+#include <drivers/st/stm32_i2c.h>
+#include <lib/mmio.h>
+#include <lib/spinlock.h>
+#include <lib/utils_def.h>
+#include "pca9450.h"
+
+#define PMIC_NODE_NOT_FOUND	1
+
+static struct pmic_handle_s pca9450_handle;
+static struct i2c_handle_s i2c_handle;
+static enum pca9450_variant chip_variant;
+
+/* This driver is monoinstance */
+static struct pmic_handle_s *pca9450;
+
+static int dt_get_pmic_node(void *fdt)
+{
+	static int node = -FDT_ERR_BADOFFSET;
+
+	if (node == -FDT_ERR_BADOFFSET)
+		node = fdt_node_offset_by_compatible(fdt, -1, "nxp,pca9450");
+
+	return node;
+}
+
+int dt_pmic_status(void)
+{
+	static int status = -FDT_ERR_BADVALUE;
+	int node;
+	void *fdt;
+
+	if (status != -FDT_ERR_BADVALUE)
+		return status;
+
+	if (fdt_get_address(&fdt) == 0)
+		return -ENOENT;
+
+	node = dt_get_pmic_node(fdt);
+	if (node <= 0)
+		return node;
+
+	return DT_SECURE;
+}
+
+/*
+ * Get PMIC and its I2C bus configuration from the device tree.
+ * Return 0 on success, negative on error, 1 if no PMIC node is defined.
+ */
+static int dt_pca9450_i2c_config(struct dt_node_info *i2c_info,
+				 struct stm32_i2c_init_s *init,
+				 uint32_t *i2c_addr)
+{
+	static int i2c_node = -FDT_ERR_NOTFOUND;
+	void *fdt;
+
+	if (fdt_get_address(&fdt) == 0)
+		return -FDT_ERR_NOTFOUND;
+
+	if (i2c_node == -FDT_ERR_NOTFOUND) {
+		int pmic_node;
+		const fdt32_t *cuint;
+
+		pmic_node = dt_get_pmic_node(fdt);
+		if (pmic_node < 0)
+			return PMIC_NODE_NOT_FOUND;
+
+		cuint = fdt_getprop(fdt, pmic_node, "reg", NULL);
+		if (cuint == NULL)
+			return -FDT_ERR_NOTFOUND;
+
+		*i2c_addr = fdt32_to_cpu(*cuint) << 1;
+		if (*i2c_addr > UINT16_MAX)
+			return -FDT_ERR_BADVALUE;
+
+		i2c_node = fdt_parent_offset(fdt, pmic_node);
+		if (i2c_node < 0)
+			return -FDT_ERR_NOTFOUND;
+	}
+
+	dt_fill_device_info(i2c_info, i2c_node);
+	if (i2c_info->base == 0)
+		return -FDT_ERR_NOTFOUND;
+
+	i2c_info->status = DT_SECURE;
+	return stm32_i2c_get_setup_from_fdt(fdt, i2c_node, init);
+}
+
+bool initialize_pmic_i2c(void)
+{
+	int ret;
+	struct dt_node_info i2c_info;
+	struct i2c_handle_s *i2c = &i2c_handle;
+	uint32_t i2c_addr = 0;
+	struct stm32_i2c_init_s i2c_init;
+
+	ret = dt_pca9450_i2c_config(&i2c_info, &i2c_init, &i2c_addr);
+	if (ret < 0) {
+		ERROR("I2C configuration failed %d\n", ret);
+		panic();
+	}
+
+	if (ret)
+		return false;
+
+	/* Initialize PMIC I2C */
+	i2c->i2c_base_addr		= i2c_info.base;
+	i2c->dt_status			= i2c_info.status;
+	i2c->clock			= i2c_info.clock;
+	i2c->i2c_state			= I2C_STATE_RESET;
+	i2c_init.own_address1		= i2c_addr;
+	i2c_init.addressing_mode	= I2C_ADDRESSINGMODE_7BIT;
+	i2c_init.dual_address_mode	= I2C_DUALADDRESS_DISABLE;
+	i2c_init.own_address2		= 0;
+	i2c_init.own_address2_masks	= I2C_OAR2_OA2NOMASK;
+	i2c_init.general_call_mode	= I2C_GENERALCALL_DISABLE;
+	i2c_init.no_stretch_mode	= I2C_NOSTRETCH_DISABLE;
+	i2c_init.analog_filter		= 1;
+	i2c_init.digital_filter_coef	= 0;
+
+	ret = stm32_i2c_init(i2c, &i2c_init);
+	if (ret) {
+		ERROR("Cannot initialize I2C %x (%d)\n",
+		      i2c->i2c_base_addr, ret);
+		panic();
+	}
+
+	if (!stm32_i2c_is_device_ready(i2c, i2c_addr, 1,
+				       I2C_TIMEOUT_BUSY_MS)) {
+		ERROR("I2C device not ready\n");
+		panic();
+	}
+
+	pca9450 = &pca9450_handle;
+	pca9450->i2c_handle = &i2c_handle;
+	pca9450->i2c_addr = i2c_addr;
+
+	return true;
+}
+
+static int pca9450_set_state(const struct regul_description *desc, bool enable)
+{
+	size_t id = (size_t)desc->driver_data;
+
+	VERBOSE("%s: set state to %d\n", desc->node_name, enable);
+
+	return pca9450_regulator_set_state(pca9450, id, enable);
+}
+
+static int pca9450_get_state(const struct regul_description *desc)
+{
+	size_t id = (size_t)desc->driver_data;
+	bool enabled;
+
+	VERBOSE("%s: get state\n", desc->node_name);
+
+	if (pca9450_regulator_get_state(pca9450, id, &enabled) < 0) {
+		panic();
+	}
+
+	return enabled;
+}
+
+static int pca9450_get_voltage(const struct regul_description *desc)
+{
+	size_t id = (size_t)desc->driver_data;
+	uint16_t mv;
+
+	VERBOSE("%s: get volt\n", desc->node_name);
+
+	if (pca9450_regulator_get_voltage(pca9450, id, &mv) < 0)
+		panic();
+
+	return mv;
+}
+
+static int pca9450_set_voltage(const struct regul_description *desc, uint16_t mv)
+{
+	size_t id = (size_t)desc->driver_data;
+
+	VERBOSE("%s: set voltage to %umv\n", desc->node_name, mv);
+
+	return pca9450_regulator_set_voltage(pca9450, id, mv);
+}
+
+static int pca9450_list_voltages(const struct regul_description *desc,
+			       const uint16_t **levels, size_t *count)
+{
+	size_t id = (size_t)desc->driver_data;
+
+	VERBOSE("%s: list volt\n", desc->node_name);
+
+	return pca9450_regulator_levels_mv(pca9450, id, levels, count);
+}
+
+static int pca9450_set_flag(const struct regul_description *desc, uint16_t flag)
+{
+	size_t id = (size_t)desc->driver_data;
+	int ret;
+
+	VERBOSE("%s: set_flag 0x%x\n", desc->node_name, flag);
+
+	switch (flag) {
+	case REGUL_PULL_DOWN:
+		ret = pca9450_regulator_set_prop(pca9450, id, PCA9450_PULL_DOWN, 1U);
+		return ret;
+
+	default:
+		ERROR("Invalid flag %u", flag);
+		panic();
+	}
+	return 0;
+}
+
+int pca9450_set_prop(const struct regul_description *desc, uint16_t prop, uint16_t value)
+{
+	size_t id = (size_t)desc->driver_data;
+	int ret;
+
+	VERBOSE("%s: set_prop 0x%x val=%u\n", desc->node_name, prop, value);
+
+	ret = pca9450_regulator_set_prop(pca9450, id, prop, value);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static const struct regul_ops pca9450_ops = {
+	.set_state = pca9450_set_state,
+	.get_state = pca9450_get_state,
+	.set_voltage = pca9450_set_voltage,
+	.get_voltage = pca9450_get_voltage,
+	.list_voltages = pca9450_list_voltages,
+	.set_flag = pca9450_set_flag,
+};
+
+#define DEFINE_REGUL(rid, name)			\
+[rid] = {					\
+	.node_name = name,			\
+	.ops = &pca9450_ops,			\
+	.driver_data = (const void *)rid,	\
+}
+
+static const struct regul_description pca9450_descs[] = {
+	DEFINE_REGUL(PCA9450_LDO1, "ldo1"),
+	DEFINE_REGUL(PCA9450_LDO2, "ldo2"),
+	DEFINE_REGUL(PCA9450_LDO3, "ldo3"),
+	DEFINE_REGUL(PCA9450_LDO4, "ldo4"),
+	DEFINE_REGUL(PCA9450_LDO5, "ldo5"),
+	DEFINE_REGUL(PCA9450_BUCK1, "buck1"),
+	DEFINE_REGUL(PCA9450_BUCK2, "buck2"),
+	DEFINE_REGUL(PCA9450_BUCK3, "buck3"),
+	DEFINE_REGUL(PCA9450_BUCK4, "buck4"),
+	DEFINE_REGUL(PCA9450_BUCK5, "buck5"),
+	DEFINE_REGUL(PCA9450_BUCK6, "buck6"),
+};
+
+static int pca9450_init_voltage(const struct regul_description *desc,
+				const void *fdt, int node)
+{
+	const uint32_t *prop;
+	uint16_t min_mv = 0;
+	uint16_t max_mv = 0;
+	uint16_t cur_mv;
+
+	prop = fdt_getprop(fdt, node, "regulator-min-microvolt", NULL);
+	if (prop)
+		min_mv = fdt32_to_cpu(*prop) / 1000;
+
+	prop = fdt_getprop(fdt, node, "regulator-max-microvolt", NULL);
+	if (prop)
+		max_mv = fdt32_to_cpu(*prop) / 1000;
+	if (min_mv && max_mv && min_mv > max_mv) {
+		ERROR("%s: regulator-min-microvolt > regulator-max-microvolt\n",
+		      desc->node_name);
+		return -EINVAL;
+	} else if (!min_mv) {
+		min_mv = max_mv;
+	}
+	cur_mv = pca9450_get_voltage(desc);
+	if (min_mv) {
+		if (min_mv != cur_mv) {
+			INFO("%s: changing %s voltage from %umV to %umV\n",
+			     __func__, desc->node_name, cur_mv, min_mv);
+			return pca9450_set_voltage(desc, min_mv);
+		}
+		INFO("%s: leaving %s voltage at %umV\n",
+		     __func__, desc->node_name, cur_mv);
+	}
+	return 0;
+}
+
+static int register_pca9450(void)
+{
+	void *fdt;
+	int pmic_node, regulators_node, subnode;
+	size_t i;
+
+	INFO("Register pca9450\n");
+
+	if (fdt_get_address(&fdt) == 0)
+		return -FDT_ERR_NOTFOUND;
+
+	pmic_node = dt_get_pmic_node(fdt);
+	if (pmic_node < 0)
+		return pmic_node;
+
+	regulators_node = fdt_subnode_offset(fdt, pmic_node, "regulators");
+	if (regulators_node < 0)
+		return regulators_node;
+
+	for (i = 0; i < ARRAY_SIZE(pca9450_descs); i++) {
+		const struct regul_description *desc = &pca9450_descs[i];
+
+		fdt_for_each_subnode(subnode, fdt, regulators_node) {
+			const char *reg_name = fdt_get_name(fdt, subnode, NULL);
+			int ret;
+
+			if (strcmp(desc->node_name, reg_name) == 0) {
+				ret = regulator_register(desc, subnode);
+				if (ret) {
+					WARN("%s failed to register %s: %d\n",
+					     __func__, reg_name, ret);
+					return ret;
+				}
+				ret = pca9450_init_voltage(desc, fdt, subnode);
+				if (ret)
+					return ret;
+
+				desc = NULL;
+				break;
+			}
+		}
+		if (!desc)
+			continue;
+
+		/* regulator is not in use */
+		if (chip_variant == PCA9450A && i == PCA9450_LDO2) {
+			/*
+			 * Turning off LDO2 on PCA9450A puts the chip
+			 * into READY mode
+			 */
+			NOTICE("%s: leaving unused regulator %s on for PCA9450A\n",
+			       __func__, desc->node_name);
+		} else {
+			NOTICE("%s: disabling unused regulator %s\n",
+			       __func__, desc->node_name);
+			pca9450_set_state(desc, 0);
+		}
+	}
+	return 0;
+}
+
+void initialize_pmic(void)
+{
+	int ret;
+	uint8_t val;
+
+	ret = initialize_pmic_i2c();
+	if (!ret) {
+		ERROR("No PCA9450\n");
+		return;
+	}
+
+	if (pca9450_get_chip_id(pca9450, &val)) {
+		ERROR("Failed to access PMIC\n");
+		panic();
+	}
+	switch ((val & CHIP_ID_MASK) >> CHIP_ID_SHIFT) {
+	case CHIP_ID_PCA9450A:
+		chip_variant = PCA9450A;
+		break;
+	case CHIP_ID_PCA9450BC:
+		chip_variant = PCA9450BC;
+		break;
+	default:
+		ERROR("Unsupported PCA9450 chip ID: 0x%02x\n", val);
+		panic();
+	}
+	NOTICE("PCA9450%s chip ID = 0x%02x\n",
+	       chip_variant == PCA9450A ? "A" : "B/C", val);
+
+	pca9450_init();
+
+	ret = register_pca9450();
+	if (ret < 0) {
+		ERROR("Register pca9450 failed: %d\n", ret);
+		panic();
+	}
+
+#if EVENT_LOG_LEVEL == LOG_LEVEL_NOTICE
+	pca9450_dump_regulators(pca9450);
+#endif
+}
