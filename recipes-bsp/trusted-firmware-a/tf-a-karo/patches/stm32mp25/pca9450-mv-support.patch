+
+#ifndef __PCA9450_H
+#define __PCA9450_H
+
+#include <drivers/st/stm32_i2c.h>
+#include <lib/utils_def.h>
+
+#ifndef SD_VSEL
+#define SD_VSEL 0
+#endif
+
+enum regulator_id {
+	PCA9450_BUCK1,
+	PCA9450_BUCK2,
+	PCA9450_BUCK3,
+	PCA9450_BUCK4,
+	PCA9450_BUCK5,
+	PCA9450_BUCK6,
+	PCA9450_LDO1,
+	PCA9450_LDO2,
+	PCA9450_LDO3,
+	PCA9450_LDO4,
+	PCA9450_LDO5,
+};
+
+enum pca9450_variant {
+	PCA9450A,
+	PCA9450BC,
+};
+
+#define CHIP_ID_MASK		0xf0
+#define CHIP_ID_SHIFT		4
+#define CHIP_ID_PCA9450A	1
+#define CHIP_ID_PCA9450BC	3
+
+/* Status Registers */
+#define DEVICE_ID		0x00
+#define INT1			0x01
+#define RESET_CTRL		0x08
+#define CONFIG1			0x09
+#define CONFIG2			0x0a
+#define BUCK123_DVS		0x0c
+#define BUCK1OUT_LIMIT		0x0d
+#define BUCK2OUT_LIMIT		0x0e
+#define BUCK3OUT_LIMIT		0x0f
+#define BUCK1CTRL		0x10
+#define BUCK1OUT_DVS0		0x11
+#define BUCK1OUT_DVS1		0x12
+#define BUCK2CTRL		0x13
+#define BUCK2OUT_DVS0		0x14
+#define BUCK2OUT_DVS1		0x15
+#define BUCK3CTRL		0x16
+#define BUCK3OUT_DVS0		0x17
+#define BUCK3OUT_DVS1		0x18
+#define BUCK4CTRL		0x19
+#define BUCK4OUT		0x1a
+#define BUCK5CTRL		0x1b
+#define BUCK5OUT		0x1c
+#define BUCK6CTRL		0x1d
+#define BUCK6OUT		0x1e
+#define LDO_AD_CTRL		0x20
+#define LDO1CTRL		0x21
+#define LDO2CTRL		0x22
+#define LDO3CTRL		0x23
+#define LDO4CTRL		0x24
+#if SD_VSEL == 0
+#define LDO5CTRL		0x25
+#else
+#define LDO5CTRL		0x26
+#endif
+#define LOADSW_CTRL		0x2a
+#define VRFLT1_STS		0x2b
+#define VRFLT2_STS		0x2c
+#define VRFLT1_MASK		0x2d
+#define VRFLT2_MASK		0x2e
+
+#define BUCK_ENMODE		(0x3 << 0)
+#define LDO_ENMODE		(0x3 << 6)
+
+#define BUCK_AD_BIT		BIT(3)
+#define LDO1_AD_BIT		BIT(7)
+#define LDO2_AD_BIT		BIT(6)
+#define LDO3_AD_BIT		BIT(5)
+#define LDO4_AD_BIT		BIT(4)
+#define LDO5_AD_BIT		BIT(3)
+
+enum pca9450_prop_id {
+	PCA9450_MASK_RESET,
+	PCA9450_PULL_DOWN,
+};
+
+struct pmic_handle_s {
+	struct i2c_handle_s *i2c_handle;
+	uint16_t i2c_addr;
+	unsigned int pmic_status;
+};
+
+void pca9450_init(void);
+
+int pca9450_register_read(struct pmic_handle_s *pmic,
+			  uint16_t register_id, uint8_t *value);
+int pca9450_register_write(struct pmic_handle_s *pmic,
+			   uint16_t register_id, uint8_t value);
+int pca9450_register_update(struct pmic_handle_s *pmic,
+			    uint16_t register_id, uint8_t value, uint8_t mask);
+
+int pca9450_regulator_set_state(struct pmic_handle_s *pmic,
+				uint8_t id, bool enable);
+int pca9450_regulator_get_state(struct pmic_handle_s *pmic,
+				uint8_t id, bool *enabled);
+
+int pca9450_regulator_levels_mv(struct pmic_handle_s *pmic,
+				uint8_t id, const uint16_t **levels,
+				size_t *levels_count);
+int pca9450_regulator_get_voltage(struct pmic_handle_s *pmic,
+				  uint8_t id, uint16_t *val);
+int pca9450_regulator_set_voltage(struct pmic_handle_s *pmic,
+				  uint8_t id, uint16_t millivolts);
+
+#if EVENT_LOG_LEVEL == LOG_LEVEL_VERBOSE
+void pca9450_dump_regulators(struct pmic_handle_s *pmic);
+#endif
+
+int pca9450_get_chip_id(struct pmic_handle_s *pmic, uint8_t *val);
+
+int pca9450_regulator_get_prop(struct pmic_handle_s *pmic, size_t id,
+			       enum pca9450_prop_id prop);
+
+int pca9450_regulator_set_prop(struct pmic_handle_s *pmic, size_t id,
+			       enum pca9450_prop_id prop, uint32_t arg);
+
+#endif /* __PCA9450_H */
