From 9def8b75bfb8acc696be37603d842e278b8c3e93 Mon Sep 17 00:00:00 2001
From: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Date: Mon, 4 Mar 2024 11:32:04 +0100
Subject: [PATCH 2/2] Modify-Reset-reason-trace-level

Signed-off-by: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
---
 stm32mp1/bl2_plat_setup.c |   30 +++++++++++++++---------------
 stm32mp2/bl2_plat_setup.c |   34 +++++++++++++++++-----------------
 2 files changed, 32 insertions(+), 32 deletions(-)

Index: tf-a-qsmp-1510/plat/st/stm32mp1/bl2_plat_setup.c
===================================================================
--- tf-a-qsmp-1510.orig/plat/st/stm32mp1/bl2_plat_setup.c
+++ tf-a-qsmp-1510/plat/st/stm32mp1/bl2_plat_setup.c
@@ -75,80 +75,80 @@ static void print_reset_reason(void)
 		return;
 	}
 
-	INFO("Reset reason (0x%x):\n", rstsr);
+	NOTICE("Reset reason (0x%x):\n", rstsr);
 
 	if ((rstsr & RCC_MP_RSTSCLRR_PADRSTF) == 0U) {
 		if ((rstsr & RCC_MP_RSTSCLRR_STDBYRSTF) != 0U) {
-			INFO("System exits from STANDBY\n");
+			NOTICE("System exits from STANDBY\n");
 			return;
 		}
 
 		if ((rstsr & RCC_MP_RSTSCLRR_CSTDBYRSTF) != 0U) {
-			INFO("MPU exits from CSTANDBY\n");
+			NOTICE("MPU exits from CSTANDBY\n");
 			return;
 		}
 	}
 
 	if ((rstsr & RCC_MP_RSTSCLRR_PORRSTF) != 0U) {
-		INFO("  Power-on Reset (rst_por)\n");
+		NOTICE("  Power-on Reset (rst_por)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_MP_RSTSCLRR_BORRSTF) != 0U) {
-		INFO("  Brownout Reset (rst_bor)\n");
+		NOTICE("  Brownout Reset (rst_bor)\n");
 		return;
 	}
 
 #if STM32MP15
 	if ((rstsr & RCC_MP_RSTSCLRR_MCSYSRSTF) != 0U) {
 		if ((rstsr & RCC_MP_RSTSCLRR_PADRSTF) != 0U) {
-			INFO("  System reset generated by MCU (MCSYSRST)\n");
+			NOTICE("  System reset generated by MCU (MCSYSRST)\n");
 		} else {
-			INFO("  Local reset generated by MCU (MCSYSRST)\n");
+			NOTICE("  Local reset generated by MCU (MCSYSRST)\n");
 		}
 		return;
 	}
 #endif
 
 	if ((rstsr & RCC_MP_RSTSCLRR_MPSYSRSTF) != 0U) {
-		INFO("  System reset generated by MPU (MPSYSRST)\n");
+		NOTICE("  System reset generated by MPU (MPSYSRST)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_MP_RSTSCLRR_HCSSRSTF) != 0U) {
-		INFO("  Reset due to a clock failure on HSE\n");
+		NOTICE("  Reset due to a clock failure on HSE\n");
 		return;
 	}
 
 	if ((rstsr & RCC_MP_RSTSCLRR_IWDG1RSTF) != 0U) {
-		INFO("  IWDG1 Reset (rst_iwdg1)\n");
+		NOTICE("  IWDG1 Reset (rst_iwdg1)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_MP_RSTSCLRR_IWDG2RSTF) != 0U) {
-		INFO("  IWDG2 Reset (rst_iwdg2)\n");
+		NOTICE("  IWDG2 Reset (rst_iwdg2)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_MP_RSTSCLRR_MPUP0RSTF) != 0U) {
-		INFO("  MPU Processor 0 Reset\n");
+		NOTICE("  MPU Processor 0 Reset\n");
 		return;
 	}
 
 #if STM32MP15
 	if ((rstsr & RCC_MP_RSTSCLRR_MPUP1RSTF) != 0U) {
-		INFO("  MPU Processor 1 Reset\n");
+		NOTICE("  MPU Processor 1 Reset\n");
 		return;
 	}
 #endif
 
 	if ((rstsr & RCC_MP_RSTSCLRR_PADRSTF) != 0U) {
-		INFO("  Pad Reset from NRST\n");
+		NOTICE("  Pad Reset from NRST\n");
 		return;
 	}
 
 	if ((rstsr & RCC_MP_RSTSCLRR_VCORERSTF) != 0U) {
-		INFO("  Reset due to a failure of VDD_CORE\n");
+		NOTICE("  Reset due to a failure of VDD_CORE\n");
 		return;
 	}
 
Index: tf-a-qsmp-1510/plat/st/stm32mp2/bl2_plat_setup.c
===================================================================
--- tf-a-qsmp-1510.orig/plat/st/stm32mp2/bl2_plat_setup.c
+++ tf-a-qsmp-1510/plat/st/stm32mp2/bl2_plat_setup.c
@@ -93,89 +93,89 @@ static void print_reset_reason(void)
 		return;
 	}
 
-	INFO("Reset reason (0x%x):\n", rstsr);
+	NOTICE("Reset reason (0x%x):\n", rstsr);
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_PADRSTF) == 0U) {
 		if ((rstsr & RCC_C1BOOTRSTSCLRR_STBYC1RSTF) != 0U) {
-			INFO("System exits from Standby for CA35\n");
+			NOTICE("System exits from Standby for CA35\n");
 			return;
 		}
 
 		if ((rstsr & RCC_C1BOOTRSTSCLRR_D1STBYRSTF) != 0U) {
-			INFO("D1 domain exits from DStandby\n");
+			NOTICE("D1 domain exits from DStandby\n");
 			return;
 		}
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_PORRSTF) != 0U) {
-		INFO("  Power-on Reset (rst_por)\n");
+		NOTICE("  Power-on Reset (rst_por)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_BORRSTF) != 0U) {
-		INFO("  Brownout Reset (rst_bor)\n");
+		NOTICE("  Brownout Reset (rst_bor)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSSETR_SYSC2RSTF) != 0U) {
-		INFO("  System reset (SYSRST) by M33\n");
+		NOTICE("  System reset (SYSRST) by M33\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSSETR_SYSC1RSTF) != 0U) {
-		INFO("  System reset (SYSRST) by A35\n");
+		NOTICE("  System reset (SYSRST) by A35\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_HCSSRSTF) != 0U) {
-		INFO("  Clock failure on HSE\n");
+		NOTICE("  Clock failure on HSE\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_IWDG1SYSRSTF) != 0U) {
-		INFO("  IWDG1 system reset (rst_iwdg1)\n");
+		NOTICE("  IWDG1 system reset (rst_iwdg1)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_IWDG2SYSRSTF) != 0U) {
-		INFO("  IWDG2 system reset (rst_iwdg2)\n");
+		NOTICE("  IWDG2 system reset (rst_iwdg2)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_IWDG3SYSRSTF) != 0U) {
-		INFO("  IWDG3 system reset (rst_iwdg3)\n");
+		NOTICE("  IWDG3 system reset (rst_iwdg3)\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_IWDG4SYSRSTF) != 0U) {
-		INFO("  IWDG4 system reset (rst_iwdg4)\n");
+		NOTICE("  IWDG4 system reset (rst_iwdg4)\n");
 		return;
 	}
 
 #if !STM32MP21
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_IWDG5SYSRSTF) != 0U) {
-		INFO("  IWDG5 system reset (rst_iwdg5)\n");
+		NOTICE("  IWDG5 system reset (rst_iwdg5)\n");
 		return;
 	}
 #endif /* !STM32MP21 */
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_C1P1RSTF) != 0U) {
-		INFO("  A35 processor core 1 reset\n");
+		NOTICE("  A35 processor core 1 reset\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_PADRSTF) != 0U) {
-		INFO("  Pad Reset from NRST\n");
+		NOTICE("  Pad Reset from NRST\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_VCORERSTF) != 0U) {
-		INFO("  Reset due to a failure of VDD_CORE\n");
+		NOTICE("  Reset due to a failure of VDD_CORE\n");
 		return;
 	}
 
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_C1RSTF) != 0U) {
-		INFO("  A35 processor reset\n");
+		NOTICE("  A35 processor reset\n");
 		return;
 	}
 
