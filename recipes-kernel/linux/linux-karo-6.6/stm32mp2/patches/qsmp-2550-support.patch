+			>;
+			bias-pull-up;
+		};
+	};
+
+	uart5_sleep_pins: uart5-sleep-pins {
+		pins {
+			pinmux = <
+				  STM32_PINMUX('D', 3, ANALOG)	/* UART5_TX */
+				  STM32_PINMUX('D', 0, ANALOG)	/* UART5_RX */
+			>;
+		};
+	};
+
+	usart3_pins: usart3-pins {
+		pins1 {
+			pinmux = <STM32_PINMUX('I', 6, AF6)>;	/* USART3_TX */
