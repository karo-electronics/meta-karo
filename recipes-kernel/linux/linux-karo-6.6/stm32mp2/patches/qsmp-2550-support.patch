+			slew-rate = <0>;
+		};
+
+		pins2 {
+			pinmux = <STM32_PINMUX('G', 1, AF5)>;	/* UART5_CTS_NSS */
+			bias-pull-up;
+		};
+	};
+
+	uart5_rtscts_idle_pins: uart5-rtscts-idle-pins {
+		pins1 {
+			pinmux = <STM32_PINMUX('G', 8, AF5)>;	/* UART5_RTS */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+
+		pins2 {
+			pinmux = <STM32_PINMUX('G', 1, ANALOG)>; /* UART5_CTS_NSS */
+			bias-pull-up;
+		};
+	};
+
+	uart5_rtscts_sleep_pins: uart5-rtscts-sleep-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('G', 8, ANALOG)	/* UART5_RTS */
