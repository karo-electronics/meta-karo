+				  STM32_PINMUX('D', 7, ANALOG)	/* SPI4_SCLK */
+				  STM32_PINMUX('D', 6, ANALOG)	/* SPI4_MOSI */
+				  STM32_PINMUX('D', 4, ANALOG)	/* SPI4_MISO */
+			>;
