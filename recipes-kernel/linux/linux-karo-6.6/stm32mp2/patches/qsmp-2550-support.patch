+			slew-rate = <2>;
+		};
+
+		pins2 {
+			pinmux = <STM32_PINMUX('E', 14, AF12)>;	/* SDMMC2_CK */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <3>;
+		};
+
+		pins3 {
+			pinmux = <STM32_PINMUX('E', 15, AF12)>;	/* SDMMC2_CMD */
+			bias-pull-up;
+			drive-open-drain;
+			slew-rate = <2>;
+		};
+	};
+
+	sdmmc2_sleep_pins: sdmmc2-sleep-pins {
+		pins {
+			pinmux = <
+				  STM32_PINMUX('E', 13, ANALOG)	/* SDMMC2_D0 */
+				  STM32_PINMUX('E', 11, ANALOG)	/* SDMMC2_D1 */
+				  STM32_PINMUX('E', 8, ANALOG)	/* SDMMC2_D2 */
+				  STM32_PINMUX('E', 12, ANALOG)	/* SDMMC2_D3 */
+				  STM32_PINMUX('E', 10, ANALOG)	/* SDMMC2_D4 */
+				  STM32_PINMUX('E', 9, ANALOG)	/* SDMMC2_D5 */
+				  STM32_PINMUX('E', 6, ANALOG)	/* SDMMC2_D6 */
+				  STM32_PINMUX('E', 7, ANALOG)	/* SDMMC2_D7 */
+				  STM32_PINMUX('E', 14, ANALOG)	/* SDMMC2_CK */
+				  STM32_PINMUX('E', 15, ANALOG)	/* SDMMC2_CMD */
+			>;
+		};
+	};
+
+	sdmmc3_pins: sdmmc3-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('B', 14, AF10)	/* SDMMC3_D0 */
+				  STM32_PINMUX('D', 13, AF10)	/* SDMMC3_D1 */
+				  STM32_PINMUX('B', 12, AF10)	/* SDMMC3_D2 */
+				  STM32_PINMUX('I', 11, AF10)	/* SDMMC3_D3 */
+				  STM32_PINMUX('D', 12, AF10)	/* SDMMC3_CMD */
+			>;
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <2>;
+		};
+
+		pins2 {
+			pinmux = <STM32_PINMUX('B', 13, AF10)>;	/* SDMMC3_CK */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <3>;
+		};
+	};
+
+	sdmmc3_opendrain_pins: sdmmc3-opendrain-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('B', 14, AF10)	/* SDMMC3_D0 */
+				  STM32_PINMUX('D', 13, AF10)	/* SDMMC3_D1 */
+				  STM32_PINMUX('B', 12, AF10)	/* SDMMC3_D2 */
+				  STM32_PINMUX('I', 11, AF10)	/* SDMMC3_D3 */
+			>;
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <2>;
+		};
+
+		pins2 {
+			pinmux = <STM32_PINMUX('B', 13, AF10)>;	/* SDMMC3_CK */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <3>;
+		};
+
+		pins3 {
+			pinmux = <STM32_PINMUX('D', 12, AF10)>;	/* SDMMC3_CMD */
+			bias-disable;
+			drive-open-drain;
+			slew-rate = <2>;
+		};
+	};
+
+	sdmmc3_sleep_pins: sdmmc3-sleep-pins {
+		pins {
+			pinmux = <
+				  STM32_PINMUX('B', 14, ANALOG)	/* SDMMC3_D0 */
+				  STM32_PINMUX('D', 13, ANALOG)	/* SDMMC3_D1 */
+				  STM32_PINMUX('B', 12, ANALOG)	/* SDMMC3_D2 */
+				  STM32_PINMUX('I', 11, ANALOG)	/* SDMMC3_D3 */
+				  STM32_PINMUX('D', 12, ANALOG)	/* SDMMC3_CMD */
+				  STM32_PINMUX('B', 13, ANALOG)	/* SDMMC3_CK */
+			>;
+		};
+	};
+
+	spi4_pins: spi4-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('D', 7, AF1)	/* SPI4_SCLK */
+				  STM32_PINMUX('D', 6, AF1)	/* SPI4_MOSI */
