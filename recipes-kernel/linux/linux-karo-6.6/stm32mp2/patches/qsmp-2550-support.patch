Index: linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-txmp-keypad.dts
===================================================================
--- /dev/null
+++ linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-txmp-keypad.dts
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Copyright (C) 2024 Lothar Waßmann <LW@KARO-electronics.de>
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/dts-v1/;
+
+/plugin/;
+
+&{/} {
+	chosen {
+		overlays {
+			txmp-keypad;
+		};
+	};
+
+	matrix_keypad: matrix-keypad {
+		compatible = "gpio-matrix-keypad";
+		debounce-delay-ms = <5>;
+		col-scan-delay-us = <2>;
+		col-gpios = <
+			     &gpioc 12 GPIO_ACTIVE_HIGH
+			     &gpioc 7 GPIO_ACTIVE_HIGH
+			     &gpioc 4 GPIO_ACTIVE_HIGH
+			     &gpioz 8 GPIO_ACTIVE_HIGH
+		>;
+		row-gpios = <
+			     &gpiog 0 GPIO_ACTIVE_HIGH
+			     &gpioc 3 GPIO_ACTIVE_HIGH
+			     &gpioc 8 GPIO_ACTIVE_HIGH
+			     &gpiof 4 GPIO_ACTIVE_HIGH
+		>;
+		linux,keymap = <
+			        MATRIX_KEY(0, 0, KEY_POWER)
+		>;
+		wakeup-source;
+	};
+};
Index: linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-txmp-lcd-panel.dts
===================================================================
--- /dev/null
+++ linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-txmp-lcd-panel.dts
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Copyright (C) 2022 Lothar Waßmann <LW@KARO-electronics.de>
+ */
+
+/dts-v1/;
+
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/stm32-pinfunc.h>
+#include <dt-bindings/pwm/pwm.h>
+#include "includes/stm32mp25-karo-lcd-panel.dtsi"
+
+&{/chosen} {
+	overlays {
+		txmp-lcd-panel;
+	};
+};
+
+&lcd_backlight {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&backlight_pwm_pins>;
+	pinctrl-1 = <&backlight_pwm_sleep_pins>;
+	pwms = <&backlight_pwm 1 500000 PWM_POLARITY_INVERTED>;
+};
+
+&timers1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	backlight_pwm: pwm {
+		#pwm-cells = <3>;
+		status = "okay";
+	};
+
+	timer@0 {
+		reg = <0>;
+		status = "okay";
+	};
+};
+
+&lcd_panel {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&txmp_ltdc_pins>;
+	pinctrl-1 = <&txmp_ltdc_sleep_pins>;
+	enable-gpios = <&gpioz 0 GPIO_ACTIVE_HIGH>; /* Pin 151 */
+	reset-gpios = <&gpioh 12 GPIO_ACTIVE_HIGH>; /* Pin 150 */
+};
+
+&pinctrl {
+	txmp_ltdc_pins: txmp-ltdc-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('H',  4, AF10) /* LCD_R0 */
+				  STM32_PINMUX('F',  7, AF13) /* LCD_R1 */
+				  STM32_PINMUX('F', 13, AF13) /* LCD_R2 */
+				  STM32_PINMUX('F', 14, AF13) /* LCD_R3 */
+				  STM32_PINMUX('F', 15, AF13) /* LCD_R4 */
+				  STM32_PINMUX('G',  3, AF13) /* LCD_R5 */
+				  STM32_PINMUX('A', 10, AF12) /* LCD_R6 */
+				  STM32_PINMUX('G',  7, AF13) /* LCD_R7 */
+				  STM32_PINMUX('F',  8, AF13) /* LCD_G0 */
+				  STM32_PINMUX('H',  5, AF10) /* LCD_G1 */
+				  STM32_PINMUX('G',  8, AF13) /* LCD_G2 */
+				  STM32_PINMUX('G',  9, AF13) /* LCD_G3 */
+				  STM32_PINMUX('A',  6, AF10) /* LCD_G4 */
+				  STM32_PINMUX('G', 11, AF13) /* LCD_G5 */
+				  STM32_PINMUX('G', 12, AF13) /* LCD_G6 */
+				  STM32_PINMUX('C',  0, AF13) /* LCD_G7 */
+				  STM32_PINMUX('F',  6, AF13) /* LCD_B0 */
+				  STM32_PINMUX('G', 14, AF13) /* LCD_B1 */
+				  STM32_PINMUX('G', 15, AF13) /* LCD_B2 */
+				  STM32_PINMUX('I',  0, AF13) /* LCD_B3 */
+				  STM32_PINMUX('I',  1, AF13) /* LCD_B4 */
+				  STM32_PINMUX('I',  2, AF13) /* LCD_B5 */
+				  STM32_PINMUX('F',  5, AF13) /* LCD_B6 */
+				  STM32_PINMUX('I',  4, AF13) /* LCD_B7 */
+			>;
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+
+		pins2 {
+			pinmux = <STM32_PINMUX('C',  6, AF14) /* LCD_CLK */
+				  STM32_PINMUX('I',  7, AF13) /* LCD_HSYNC */
+				  STM32_PINMUX('I',  6, AF13) /* LCD_VSYNC */
+			>;
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <1>;
+		};
+
+		pins3 {
+			pinmux = <
+				  STM32_PINMUX('C',  5, AF14) /* LCD_DE */
+			>;
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <3>;
+		};
+	};
+
+	txmp_ltdc_sleep_pins: txmp-ltdc-sleep-pins {
+		pins {
+			pinmux = <
+				  STM32_PINMUX('C',  6, ANALOG) /* LCD_CLK */
+				  STM32_PINMUX('I',  7, ANALOG) /* LCD_HSYNC */
+				  STM32_PINMUX('I',  6, ANALOG) /* LCD_VSYNC */
+				  STM32_PINMUX('C',  5, ANALOG) /* LCD_DE */
+				  STM32_PINMUX('H',  4, ANALOG) /* LCD_R0 */
+				  STM32_PINMUX('F',  7, ANALOG) /* LCD_R1 */
+				  STM32_PINMUX('F', 13, ANALOG) /* LCD_R2 */
+				  STM32_PINMUX('F', 14, ANALOG) /* LCD_R3 */
+				  STM32_PINMUX('F', 15, ANALOG) /* LCD_R4 */
+				  STM32_PINMUX('G',  3, ANALOG) /* LCD_R5 */
+				  STM32_PINMUX('A', 10, ANALOG) /* LCD_R6 */
+				  STM32_PINMUX('G',  7, ANALOG) /* LCD_R7 */
+				  STM32_PINMUX('F',  8, ANALOG) /* LCD_G0 */
+				  STM32_PINMUX('H',  5, ANALOG) /* LCD_G1 */
+				  STM32_PINMUX('G',  8, ANALOG) /* LCD_G2 */
+				  STM32_PINMUX('G',  9, ANALOG) /* LCD_G3 */
+				  STM32_PINMUX('A',  6, ANALOG) /* LCD_G4 */
+				  STM32_PINMUX('G', 11, ANALOG) /* LCD_G5 */
+				  STM32_PINMUX('G', 12, ANALOG) /* LCD_G6 */
+				  STM32_PINMUX('C',  0, ANALOG) /* LCD_G7 */
+				  STM32_PINMUX('F',  6, ANALOG) /* LCD_B0 */
+				  STM32_PINMUX('G', 14, ANALOG) /* LCD_B1 */
+				  STM32_PINMUX('G', 15, ANALOG) /* LCD_B2 */
+				  STM32_PINMUX('I',  0, ANALOG) /* LCD_B3 */
+				  STM32_PINMUX('I',  1, ANALOG) /* LCD_B4 */
+				  STM32_PINMUX('I',  2, ANALOG) /* LCD_B5 */
+				  STM32_PINMUX('F',  5, ANALOG) /* LCD_B6 */
+				  STM32_PINMUX('I',  4, ANALOG) /* LCD_B7 */
+			>;
+		};
+	};
+
+	backlight_pwm_pins: backlight-pwm-pins {
+		pins {
+			pinmux = <STM32_PINMUX('D', 10, AF8)>; /* TIM1_CH2 */
+			/*
+			 * pull PWM output HIGH when PWM is disabled;
+			 * change to 'bias-pull-down' when LCD backlight pin is active HIGH
+			 */
+			bias-pull-up;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+	};
+
+	backlight_pwm_sleep_pins: backlight-pwm-sleep-pins {
+		pins {
+			pinmux = <STM32_PINMUX('D', 10, ANALOG)>; /* TIM1_CH2 */
+			/*
+			 * pull PWM output HIGH when PWM is disabled;
+			 * change to 'bias-pull-down' when LCD backlight pin is active HIGH
+			 */
+			bias-pull-up;
+		};
+	};
+};
