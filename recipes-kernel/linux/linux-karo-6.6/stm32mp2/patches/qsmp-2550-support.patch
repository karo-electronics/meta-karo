+
+	spi7_pins: spi7-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('B', 13, AF2)	/* SPI7_SCLK */
+				  STM32_PINMUX('G', 11, AF2)	/* SPI7_MOSI */
+			>;
