+		compatible = "panel-lvds";
+		backlight = <&lvds_backlight>;
+		status = "okay";
+
+		panel-timing {
+			clock-frequency = <54000000>;
+			hactive = <1024>;
+			vactive = <600>;
+			hfront-porch = <150>;
+			hback-porch = <150>;
+			hsync-len = <21>;
+			vfront-porch = <24>;
+			vback-porch = <24>;
+			vsync-len = <21>;
+		};
+
+		port {
+			lvds_panel_from_lvds: endpoint {
+				remote-endpoint = <&lvds_to_lvds_panel>;
+			};
+		};
+
+		display-timings {
+			TM101: TM101 {
+				clock-frequency = <68200000>;
+				hactive = <1280>;
+				vactive = <800>;
+				hback-porch = <5>;
+				hsync-len = <1>;
+				hfront-porch = <64>;
+				vback-porch = <2>;
+				vsync-len = <1>;
+				vfront-porch = <40>;
+				hsync-active = <0>;
+				vsync-active = <0>;
+				de-active = <1>;
+				pixelclk-active = <0>;
+			};
+		};
+	};
+};
+
+&ltdc {
+	rotation-memory = <&ltdc_sec_rotation>;
+	default-on;
+	status = "okay";
+
+	port {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ltdc_ep0_to_lvds: endpoint@0 {
+			reg = <0>;
+			remote-endpoint = <&lvds_from_ltdc_ep0>;
+		};
+	};
+};
+
+&lvds {
+	vdd-supply =  <&scmi_vddcore>;
+	vdda18-supply = <&scmi_v1v8>;
+	default-on;
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			lvds_from_ltdc_ep0: endpoint {
+				remote-endpoint = <&ltdc_ep0_to_lvds>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			lvds_to_lvds_panel: endpoint {
+				remote-endpoint = <&lvds_panel_from_lvds>;
+			};
+		};
+	};
+};
+
+&timers3 {
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+	status = "okay";
+
+	backlight_pwm: pwm {
+		status = "okay";
+	};
+
+	timer@2 {
+		status = "okay";
+	};
+};
+
+&pinctrl {
+	backlight_pwm_pins: backlight-pwm-pins {
+		pins {
+			pinmux = <STM32_PINMUX('F', 13, AF8)>; /* TIM3_CH3 */
+			drive-push-pull;
+			/*
+			 * pull PWM output HIGH when PWM is disabled;
+			 * change to 'bias-pull-down' when LCD backlight pin is active HIGH
+			 */
+			bias-pull-up;
+			slew-rate = <0>;
+		};
+	};
+
+	backlight_pwm_sleep_pins: backlight-pwm-sleep-pins {
+		pins {
+			pinmux = <STM32_PINMUX('F', 13, ANALOG)>; /* TIM3_CH3 */
+			/*
+			 * pull PWM output HIGH when PWM is disabled;
+			 * change to 'bias-pull-down' when LCD backlight pin is active HIGH
+			 */
+			bias-pull-up;
+		};
+	};
+};
Index: linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-qsmp-pcie.dts
===================================================================
--- /dev/null
+++ linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-qsmp-pcie.dts
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR BSD-2-Clause)
+/*
+ * Copyright (C) 2024 Lothar Waßmann <LW@KARO-electronics.de>
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pinctrl/stm32-pinfunc.h>
+
+/dts-v1/;
+
+/plugin/;
+
+&{/chosen} {
+	overlays {
+		qsmp-pcie;
+	};
+};
+
+&combophy {
+	status = "okay";
+};
+
+&pcie_rc {
+	pinctrl-names = "default", "init", "sleep";
+	pinctrl-0 = <&pcie_pins>;
+	pinctrl-1 = <&pcie_init_pins>;
+	pinctrl-2 = <&pcie_sleep_pins>;
+	reset-gpios = <&gpioi 7 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&gpioh 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+	wakeup-source;
+	status = "okay";
+};
+
+&gpioc {
+	pcie-pwr-en-hog {
+		gpio-hog;
+		gpios = <9 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "pcie-pwr_en";
+	};
+};
+
+&pinctrl {
+	pcie_pins: pcie-pins {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, AF4)>;
+			bias-disable;
+		};
+	};
+
+	pcie_init_pins: pcie-init-pins {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, GPIO)>;
+			output-low;
+		};
+	};
+
+	pcie_sleep_pins: pcie-sleep-pins {
+		pins {
+			pinmux = <STM32_PINMUX('B', 8, ANALOG)>;
+		};
+	};
+};
Index: linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-qsmp-qsbase5.dts
