+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+
+			csi2host_from_imx219: endpoint {
+				remote-endpoint = <&imx219_to_csi2host>;
+				data-lanes = <0 1>;
+				bus-type = <4>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+
+			csi2host_to_dcmipp: endpoint {
+				remote-endpoint = <&dcmipp_from_csi2host>;
+			};
+		};
+	};
+};
+
+&dcmipp {
+	status = "okay";
+
+	port {
+		dcmipp_from_csi2host: endpoint {
+			remote-endpoint = <&csi2host_to_dcmipp>;
+			bus-type = <4>; /* CSI2_DPHY */
+		};
+	};
+};
+
+&i2c2 {
+	imx219: csi-camera@10 {
+		compatible = "sony,imx219";
+		reg = <0x10>;
+		clocks = <&clk_csi>;
+		reset-gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>;
+		VANA-supply = <&reg_2v8>;   /* 2.8v */
+		VDIG-supply = <&reg_1v8>;   /* 1.8v */
+		VDDL-supply = <&reg_1v2>;   /* 1.2v */
+
+		port {
+			imx219_to_csi2host: endpoint {
+				remote-endpoint = <&csi2host_from_imx219>;
+				clock-lanes = <0>;
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <456000000>;
+			};
+		};
+	};
+};
Index: linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-qsmp-eth1-ksz9131.dts
===================================================================
--- /dev/null
+++ linux-txmp-2550/arch/arm64/boot/dts/st/stm32mp25-qsmp-eth1-ksz9131.dts
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR BSD-2-Clause)
+/*
+ * Copyright (C) 2024 Lothar Waßmann <LW@KARO-electronics.de>
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pinctrl/stm32-pinfunc.h>
+
+/dts-v1/;
+
+/plugin/;
+
+&{/chosen} {
+	overlays {
+		qsmp-eth1-ksz9131;
+	};
+};
+
+&eth1 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&eth1_mdio_pins &eth1_rgmii_pins>;
+	pinctrl-1 = <&eth1_mdio_sleep_pins &eth1_rgmii_sleep_pins>;
+	phy-mode = "rgmii-id";
+	phy-reset-gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;
+	phy-reset-delay-us = <10000>;
+	phy-reset-post-delay-us = <100>;
+	phy-handle = <&eth1_phy>;
+	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		eth1_phy: ethernet-phy@7 {
+			reg = <7>;
+			interrupt-parent = <&gpiof>;
+			interrupts = <5 IRQ_TYPE_EDGE_FALLING>;
+			micrel,force-master;
+			/* range: -290 .. 985 */
+			txc-skew-psec = <900>;
+			rxc-skew-psec = <0>;
+			/* range: -355 .. 400 */
+			txen-skew-psec = <0>;
+			txd0-skew-psec = <0>;
+			txd1-skew-psec = <0>;
+			txd2-skew-psec = <0>;
+			txd3-skew-psec = <0>;
+			rxdv-skew-psec = <0>;
+			rxd0-skew-psec = <0>;
+			rxd1-skew-psec = <0>;
+			rxd2-skew-psec = <0>;
+			rxd3-skew-psec = <0>;
+		};
+	};
+};
+
+&pinctrl {
+	eth1_mdio_pins: eth1-mdio-pins {
+		pins1 {
+			pinmux = <STM32_PINMUX('F', 4, AF8)>;	/* ETH1_MDC */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <2>;
+		};
+
+		pins2 {
+			pinmux = <STM32_PINMUX('A', 10, AF10)>;	/* ETH1_MDIO */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+	};
+
+	eth1_mdio_sleep_pins: eth1-mdio-sleep-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('F', 4, ANALOG)	/* ETH1_MDC */
+				  STM32_PINMUX('A', 10, ANALOG)	/* ETH1_MDIO */
+			>;
+		};
+	};
+
+	eth1_rgmii_pins: eth1-rgmii-pins {
+		pins1 {
+			pinmux = <
+				  STM32_PINMUX('A', 13, AF10)	/* ETH1_TX_CTL */
+				  STM32_PINMUX('C', 0, AF12)	/* ETH1_GTX_CLK */
+				  STM32_PINMUX('A', 15, AF10)	/* ETH1_TXD0 */
+				  STM32_PINMUX('C', 1, AF10)	/* ETH1_TXD1 */
+				  STM32_PINMUX('H', 10, AF10)	/* ETH1_TXD2 */
+				  STM32_PINMUX('H', 11, AF10)	/* ETH1_TXD3 */
+			>;
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <2>;
+		};
+
+		/* KSZ9131 strap pins */
+		pins2 {
+			pinmux = <
+				  STM32_PINMUX('F', 1, AF10)	/* ETH1_RXD0 | MODE0 */
+				  STM32_PINMUX('C', 2, AF10)	/* ETH1_RXD1 | MODE1 */
+				  STM32_PINMUX('H', 12, AF10)	/* ETH1_RXD2 | MODE2 */
+				  STM32_PINMUX('H', 13, AF10)	/* ETH1_RXD3 | MODE3 */
+			>;
+			bias-pull-up;
+		};
+
+		pins3 {
+			pinmux = <
+				  STM32_PINMUX('A', 11, AF10)	/* ETH1_RX_CTL | CLK125_EN */
+				  STM32_PINMUX('H', 9, AF10)	/* ETH1_CLK125 | LED_MODE */
+			>;
+			bias-pull-down;
+		};
+
+		pins4 {
+			/* external pullup */
+			pinmux = <
+				  STM32_PINMUX('A', 14, AF10)	/* ETH1_RX_CLK | PHYAD2 */
+			>;
+			bias-disable;
+		};
+	};
+
+	eth1_rgmii_sleep_pins: eth1-rgmii-sleep-pins {
+		pins {
+			pinmux = <
+				  STM32_PINMUX('A', 13, ANALOG)	/* ETH1_TX_CTL */
+				  STM32_PINMUX('C', 0, ANALOG)	/* ETH1_GTX_CLK */
+				  STM32_PINMUX('A', 15, ANALOG)	/* ETH1_TXD0 */
+				  STM32_PINMUX('C', 1, ANALOG)	/* ETH1_TXD1 */
+				  STM32_PINMUX('H', 10, ANALOG)	/* ETH1_TXD2 */
+				  STM32_PINMUX('H', 11, ANALOG)	/* ETH1_TXD3 */
+				  STM32_PINMUX('A', 11, ANALOG)	/* ETH1_RX_CTL | CLK125_EN */
+				  STM32_PINMUX('F', 1, ANALOG)	/* ETH1_RXD0 | MODE0 */
+				  STM32_PINMUX('C', 2, ANALOG)	/* ETH1_RXD1 | MODE1 */
+				  STM32_PINMUX('H', 12, ANALOG)	/* ETH1_RXD2 | MODE2 */
+				  STM32_PINMUX('H', 13, ANALOG)	/* ETH1_RXD3 | MODE3 */
+				  STM32_PINMUX('A', 14, ANALOG)	/* ETH1_RX_CLK | PHYAD2 */
+			>;
+		};
+	};
+};
