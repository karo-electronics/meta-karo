/dts-v1/;
/plugin/;

#include <dt-bindings/clock/st,stm32mp25-rcc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/stm32-pinfunc.h>

&{/chosen} {
	overlays {
		qsmp-csi;
	};
};

&{/} {
	clocks {
		clk_csi: csi-clock {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "cam24m";
		};
	};

	reg_2v8: regulator-2v8 {
		compatible = "regulator-fixed";
		regulator-name = "2V8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
		vin-supply = <&vdd>;
	};

	reg_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		vin-supply = <&vdd>;
	};

	reg_1v2: regulator-1v2 {
		compatible = "regulator-fixed";
		regulator-name = "1V2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
		vin-supply = <&vdd>;
	};
};

&csi {
	vdd-supply =  <&scmi_vddcore>;
	vdda18-supply = <&scmi_v1v8>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			csi2host_from_imx219: endpoint {
				remote-endpoint = <&imx219_to_csi2host>;
				data-lanes = <0 1>;
				bus-type = <4>;
			};
		};

		port@1 {
			reg = <1>;

			csi2host_to_dcmipp: endpoint {
				remote-endpoint = <&dcmipp_from_csi2host>;
			};
		};
	};
};

&dcmipp {
	status = "okay";

	port {
		dcmipp_from_csi2host: endpoint {
			remote-endpoint = <&csi2host_to_dcmipp>;
			bus-type = <4>; /* CSI2_DPHY */
		};
	};
};

&i2c2 {
	imx219: csi-camera@10 {
		compatible = "sony,imx219";
		reg = <0x10>;
		clocks = <&clk_csi>;
		reset-gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>;
		VANA-supply = <&reg_2v8>;   /* 2.8v */
		VDIG-supply = <&reg_1v8>;   /* 1.8v */
		VDDL-supply = <&reg_1v2>;   /* 1.2v */

		port {
			imx219_to_csi2host: endpoint {
				remote-endpoint = <&csi2host_from_imx219>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <456000000>;
			};
		};
	};
};
