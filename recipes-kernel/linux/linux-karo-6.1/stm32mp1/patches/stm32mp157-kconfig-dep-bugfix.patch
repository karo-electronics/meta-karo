Index: linux-qsmp-1351/drivers/soc/st/Kconfig
===================================================================
--- linux-qsmp-1351.orig/drivers/soc/st/Kconfig
+++ linux-qsmp-1351/drivers/soc/st/Kconfig
@@ -3,15 +3,14 @@ if ARCH_STM32
 config STM32_HDP
 	bool "STMicroelectronics STM32MP157 Hardware Debug Port (HDP) pin control"
 	depends on MACH_STM32MP157 || MACH_STM32MP13
-	default n if MACH_STM32MP157 || MACH_STM32MP13
