Index: linux-qsmp-1351/arch/arm/Kconfig.debug
===================================================================
--- linux-qsmp-1351.orig/arch/arm/Kconfig.debug
+++ linux-qsmp-1351/arch/arm/Kconfig.debug
@@ -1273,7 +1273,7 @@ choice
 
 	config STM32MP1_DEBUG_UART
 		bool "Use STM32MP1 UART for low-level debug"
-		depends on MACH_STM32MP157
+		depends on MACH_STM32MP157 || MACH_STM32MP13
 		select DEBUG_STM32_UART
 		help
 		  Say Y here if you want kernel low-level debugging support
Index: linux-qsmp-1351/drivers/cpuidle/Kconfig.arm
