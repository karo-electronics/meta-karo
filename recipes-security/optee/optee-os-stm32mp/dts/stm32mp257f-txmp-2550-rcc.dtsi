		MUX_CFG(MUX_DSIPHY, MUX_DSIPHY_FLEX28)
		MUX_CFG(MUX_RTC, MUX_RTC_LSE)
	>;

	st,pll-1 {
		st,pll = <&pll1_cfg_1200MHz>;

		pll1_cfg_1000MHz: pll1-cfg-1000MHz {
			cfg = <25 1 1 1>;
			src = <MUX_CFG(MUX_MUXSEL5, MUXSEL_HSE)>;
		};

		pll1_cfg_1200MHz: pll1-cfg-1200MHz {
			cfg = <30 1 1 1>;
			src = <MUX_CFG(MUX_MUXSEL5, MUXSEL_HSE)>;
