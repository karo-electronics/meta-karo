-#define RNG_SR			0x04U
-#define RNG_DR			0x08U
+#define RNG_CR			U(0x00)
+#define RNG_SR			U(0x04)
+#define RNG_DR			U(0x08)
+#define RNG_NSCR		U(0x0C)
+#define RNG_HTCR		U(0x10)
+#define RNG_VERR		U(0x3F4)
 
 #define RNG_CR_RNGEN		BIT(2)
 #define RNG_CR_IE		BIT(3)
 #define RNG_CR_CED		BIT(5)
