+		io_write32(bsec_base() + BSEC_SWLOCK(bank), bank_value);
+		bsec_dev.shadow->status[otp] |= LOCK_SHADOW_W;
+		result = TEE_SUCCESS;
+	}
+
+	bsec_unlock(exceptions);
