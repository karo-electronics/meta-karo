+const uint8_t *plat_scmi_protocol_list(unsigned int channel_id __unused)
+{
+	assert(plat_scmi_protocol_count_paranoid() ==
+	       (ARRAY_SIZE(plat_protocol_list) - 1));
+
+	return plat_protocol_list;
+}
