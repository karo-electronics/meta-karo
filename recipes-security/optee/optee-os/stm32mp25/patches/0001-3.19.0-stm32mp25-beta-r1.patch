+static unsigned long clk_stm32_pll_get_oscillator_rate(int sel)
+{
+	int osc[] = { OSC_HSI, OSC_HSE, OSC_MSI };
+
+	return clk_stm32_get_rate_oscillateur(osc[sel]);
+}
