+#include <drivers/rstctrl.h>
+#include <kernel/mutex.h>
+#include <mm/core_memprot.h>
+#include <stdint.h>
+
+#define PKA_MAX_ECC_LEN		640
+#define PKA_MAX_ECC_SIZE	(PKA_MAX_ECC_LEN / 8)
+
+enum stm32_pka_curve_id {
+	PKA_NIST_P192,
+	PKA_NIST_P224,
+	PKA_NIST_P256,
+	PKA_NIST_P384,
+	PKA_NIST_P521,
+
+	PKA_LAST_CID,
+};
+
+/*
+ * struct stm32_pka_bn: internal representation of bin number
+ *
+ * @field val: a BYTE array with most significant bytes first
+ * @field size: nb of Byte of 'val'
+ */
+struct stm32_pka_bn {
+	uint8_t *val;
+	size_t size;
+};
+
+struct stm32_pka_point {
+	struct stm32_pka_bn x;
