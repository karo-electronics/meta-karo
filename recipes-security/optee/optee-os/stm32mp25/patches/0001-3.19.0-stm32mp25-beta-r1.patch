+
+	if (bank_value & mask) {
+		/* The lock is already set */
+		result = TEE_SUCCESS;
+	} else {
+		bank_value = bank_value | mask;
+
+		/*
+		 * We can write 0 in all other OTP bits with no effect,
+		 * even if the lock is activated.
