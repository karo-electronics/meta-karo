+	isb
+
+	read_scr r2
+	orr	r0, r2, #SCR_NS
+	write_scr r0
+	isb
+
+	mov	r0, #0
+	write_cntvoff r0, r0
 
+	write_scr r2
 	isb
+	msr	cpsr, r1
+	isb
+
 	bx	lr
 END_FUNC plat_cpu_reset_early
