+	uint8_t mask = 0;
+
+	if ((strncmp(name, "ldo3", 4) == 0) && ldo3_special_mode)
+		return 0;
+
+	mask = find_plat_mask(name);
+	if (mask) {
+		if (stpmic1_register_read(regul->control_reg, &value))
+			return -1;
+
+		value = (value & mask) >> LDO_BUCK_VOLTAGE_SHIFT;
