new file mode 100644
index 000000000..d212255e2
--- /dev/null
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -0,0 +1,1091 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
