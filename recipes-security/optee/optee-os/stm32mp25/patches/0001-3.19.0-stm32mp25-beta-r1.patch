+		res = watchdog_gettimeleft(&is_enabled, &timeleft);
+		if (res == TEE_ERROR_NOT_SUPPORTED) {
+			args->a0 = PSCI_RET_NOT_SUPPORTED;
+		} else if (res) {
+			args->a0 = PSCI_RET_INTERNAL_FAILURE;
+		} else if (!is_enabled) {
+			args->a0 = PSCI_RET_DISABLED;
+		} else {
+			args->a0 = PSCI_RET_SUCCESS;
+			args->a1 = timeleft;
+		}
+		break;
 	default:
 		args->a0 = PSCI_RET_NOT_SUPPORTED;
 	}
