index 000000000..deee86242
--- /dev/null
+++ b/core/drivers/stm32_bsec3.c
@@ -0,0 +1,1155 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2022, STMicroelectronics
+ */
+
+#include <assert.h>
+#include <config.h>
+#include <drivers/stm32_bsec.h>
+#include <initcall.h>
+#include <io.h>
+#include <kernel/delay.h>
