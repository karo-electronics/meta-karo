+	PWR_WKUP_PIN1 = 0,
+	PWR_WKUP_PIN2,
+	PWR_WKUP_PIN3,
+	PWR_WKUP_PIN4,
+	PWR_WKUP_PIN5,
+	PWR_WKUP_PIN6,
