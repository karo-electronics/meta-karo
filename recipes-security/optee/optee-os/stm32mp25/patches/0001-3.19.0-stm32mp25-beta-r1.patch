+static unsigned long clk_stm32_get_rate_oscillateur(int osc_id)
+{
+	struct clk_stm32_priv  *priv = clk_stm32_get_priv();
+	struct stm32_clk_platdata *pdata = priv->pdata;
+	struct stm32_osci_dt_cfg *osci = &pdata->osci[osc_id];
+
+	return osci->freq;
+}
