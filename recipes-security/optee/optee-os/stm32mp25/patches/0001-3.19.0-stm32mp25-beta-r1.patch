+static void clk_stm32_set_flexgen_as_critical(void)
+{
+	uint32_t i = 0;
+
+	for (i = 0; i < XBAR_CHANNEL_NB; i++) {
+		unsigned long clock_id = CK_ICN_HS_MCU + i;
+		struct clk *clk;
+
+		if (!stm32_rcc_has_access_by_id(i))
+			continue;
+
+		clk = stm32mp_rcc_clock_id_to_clk(clock_id);
+		assert(clk);
+
+		clk_enable(clk);
+	}
+}
+
+static bool clk_stm32_clock_is_critical(__maybe_unused struct clk *clk)
+{
+	struct clk *clk_criticals[] = {
+		&ck_hsi,
+		&ck_hse,
+		&ck_msi,
+		&ck_lsi,
+		&ck_lse,
+		&ck_cpu1,
+		&ck_icn_p_syscpu1,
+		&ck_icn_s_ddr,
+		&ck_icn_p_ddrc,
+		&ck_icn_p_ddrcfg,
+		&ck_icn_p_ddrphyc,
+		&ck_icn_s_sysram,
+		&ck_icn_s_bkpsram,
+		&ck_ker_fmc,
+		&ck_ker_ospi1,
+		&ck_ker_ospi2,
+		&ck_icn_s_vderam,
+		&ck_icn_s_lpsram1,
+		&ck_icn_s_lpsram2,
+		&ck_icn_s_lpsram3,
+		&ck_icn_p_hpdma1,
+		&ck_icn_p_hpdma2,
+		&ck_icn_p_hpdma3,
+		&ck_icn_p_gpioa,
+		&ck_icn_p_gpiob,
+		&ck_icn_p_gpioc,
+		&ck_icn_p_gpiod,
+		&ck_icn_p_gpioe,
+		&ck_icn_p_gpiof,
+		&ck_icn_p_gpiog,
+		&ck_icn_p_gpioh,
+		&ck_icn_p_gpioi,
+		&ck_icn_p_gpioj,
+		&ck_icn_p_gpiok,
+		&ck_icn_p_gpioz,
+		&ck_icn_p_ipcc1,
+		&ck_icn_p_ipcc2,
+		&ck_icn_p_gicv2m
+	};
+	size_t i = 0;
+
+	for (i = 0; i < ARRAY_SIZE(clk_criticals); i++) {
+		struct clk *clk_critical = clk_criticals[i];
+
+		if (clk == clk_critical)
+			return true;
+	}
+
+	return false;
+}
