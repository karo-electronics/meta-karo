-	otp_data->disable_on_standby = otp_value &
-				       BIT(idx + HW2_OTP_IWDG_FZ_STANDBY_SHIFT);
+	/* Enable timestamp for tamper */
+	if (stm32_rtc_set_tamper_timestamp())
