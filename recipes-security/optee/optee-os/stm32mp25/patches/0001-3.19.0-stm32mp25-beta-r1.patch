+ * @rstctrl: Reset controller manipulated by the SCMI channel
+ * @rstctrl_be: Backend reset controller device
+ */
+struct stm32_scmi_rd {
+	unsigned long reset_id;
+	bool is_exposed;
+	paddr_t base;
+	const char *name;
+	struct rstctrl *rstctrl;
+	struct rstctrl *rstctrl_be;
+};
