--- /dev/null
+++ git/core/drivers/pca9450.h
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2024, Lothar Waßmann <LW@KARO-electronics.de>
+ * based on: include/drivers/st/stpmic2.h
+ *    Copyright (c) 2022-2023, STMicroelectronics - All Rights Reserved
+ */
+
+#ifndef __PCA9450_H__
+#define __PCA9450_H__
+
+#include <tee_api_types.h>
+#include <kernel/interrupt.h>
+#include <sys/queue.h>
+
+#ifndef SD_VSEL
+#define SD_VSEL 0
+#endif
+
+enum regulator_id {
+	PCA9450_BUCK1,
+	PCA9450_BUCK2,
+	PCA9450_BUCK3,
+	PCA9450_BUCK4,
+	PCA9450_BUCK5,
+	PCA9450_BUCK6,
+	PCA9450_LDO1,
+	PCA9450_LDO2,
+	PCA9450_LDO3,
+	PCA9450_LDO4,
+	PCA9450_LDO5,
+};
+
+enum pca9450_variant {
+	PCA9450A,
+	PCA9450BC,
+};
+
+#define CHIP_ID_MASK		0xf0
+#define CHIP_ID_SHIFT		4
+#define CHIP_ID_PCA9450A	1
+#define CHIP_ID_PCA9450BC	3
+
+/* Status Registers */
+#define DEVICE_ID		0x00
+#define INT1			0x01
+#define INT1_MSK		0x02
+#define STATUS1			0x03
+#define RESET_CTRL		0x08
+#define WDOG_B_CFG_MSK		(3 << WDOG_B_CFG_SHIFT)
+#define WDOG_B_CFG_SHIFT	6
+#define PMIC_RST_CFG_MSK	(3 << PMIC_RST_CFG_SHIFT)
+#define PMIC_RST_CFG_SHIFT	4
+
+#define CONFIG1			0x09
+#define CONFIG2			0x0a
+#define BUCK123_DVS		0x0c
+#define BUCK1OUT_LIMIT		0x0d
+#define BUCK2OUT_LIMIT		0x0e
+#define BUCK3OUT_LIMIT		0x0f
+#define BUCK1CTRL		0x10
+#define BUCK1OUT_DVS0		0x11
+#define BUCK1OUT_DVS1		0x12
+#define BUCK2CTRL		0x13
+#define BUCK2OUT_DVS0		0x14
+#define BUCK2OUT_DVS1		0x15
+#define BUCK3CTRL		0x16
+#define BUCK3OUT_DVS0		0x17
+#define BUCK3OUT_DVS1		0x18
+#define BUCK4CTRL		0x19
+#define BUCK4OUT		0x1a
+#define BUCK5CTRL		0x1b
+#define BUCK5OUT		0x1c
+#define BUCK6CTRL		0x1d
+#define BUCK6OUT		0x1e
+#define LDO_AD_CTRL		0x20
+#define LDO1CTRL		0x21
+#define LDO2CTRL		0x22
+#define LDO3CTRL		0x23
+#define LDO4CTRL		0x24
+#if SD_VSEL == 0
+#define LDO5CTRL		0x25
+#else
+#define LDO5CTRL		0x26
+#endif
+#define LOADSW_CTRL		0x2a
+#define VRFLT1_STS		0x2b
+#define VRFLT2_STS		0x2c
+#define VRFLT1_MASK		0x2d
+#define VRFLT2_MASK		0x2e
+
+#define BUCK_EN_SHIFT		0
+#define LDO_EN_SHIFT		6
+#define BUCK_DVS_CTRL		BIT(4)
+
+#define REG_ENABLE_MASK		0x3
+#define REG_OFF			0x0
+#define REG_STBY_ON		0x3 /* actually 0x1! */
+#define REG_STBY_OFF		0x3 /* actually 0x2! */
+#define REG_ON			0x3
+
+#define BUCK_AD_BIT		BIT(3)
+#define LDO1_AD_BIT		BIT(7)
+#define LDO2_AD_BIT		BIT(6)
+#define LDO3_AD_BIT		BIT(5)
+#define LDO4_AD_BIT		BIT(4)
+#define LDO5_AD_BIT		BIT(3)
+
+enum pca9450_prop_id {
+	PCA9450_PULL_DOWN,
+	PCA9450_WDOG_B_RESET,
+	PCA9450_PMIC_RST_B,
+};
+
+#ifdef CFG_STM32_PWR_IRQ
+struct pmic_it_handle_s {
+	uint8_t pmic_it;
+	uint8_t notif_id;
+
+	SLIST_ENTRY(pmic_it_handle_s) link;
+};
+#endif
+
+struct pmic_handle_s {
+	struct i2c_handle_s *pmic_i2c_handle;
