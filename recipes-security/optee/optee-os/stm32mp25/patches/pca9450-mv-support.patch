--- /dev/null
+++ git/core/drivers/pca9450.c
@@ -0,0 +1,488 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2024 Lothar Waßmann <LW@KARO-electronics.de>
+ * based on:
+ *     core/arch/arm/plat-stm32mp2/drivers/stpmic2.c
+ *         Copyright (c) 2022-2023, STMicroelectronics - All Rights Reserved
+ */
+
+#include <assert.h>
+#include <platform_config.h>
+#include <stdint.h>
+#include <string.h>
+#include <trace.h>
+#include <util.h>
+#include <drivers/stm32_i2c.h>
+#include <kernel/panic.h>
+#include "pca9450.h"
+
+#define VOLTAGE_INDEX_INVALID		((size_t)~0)
+
+static const struct regulator_limits {
+       uint16_t min;
+       uint16_t max;
+       uint16_t step;
+       uint8_t mask;
+} pca9450_regulator_limits[] = {
+	{  6000, 21875,  125, 0x7f, }, /* BUCK[1..3] */
+	{  6000, 34000,  250, 0x7f, }, /* BUCK[4..6] */
+	{ 16000, 33000, 1000, 0x07, }, /* LDO[1] */
+	{  8000, 11500,  500, 0x1f, }, /* LDO[2] */
+	{  8000, 33000, 1000, 0x1f, }, /* LDO[3..4] */
+	{ 18000, 33000, 1000, 0x0f, }, /* LDO[5] */
+};
+
+struct regul_struct {
+	const char *name;
+	size_t limits;
+	uint16_t *volt_table;
+	size_t volt_table_size;
+	uint16_t volt_cr;
+	uint16_t alt_volt_cr;
+	uint16_t en_cr;
+	uint16_t pd_reg;
+	uint8_t en_shift;
+	uint8_t pd_val;
+};
+
+#define DEFINE_BUCK123(_index) {				\
+	.name			= "buck" # _index,		\
+	.en_cr			= BUCK ## _index ## CTRL,	\
+	.en_shift		= BUCK_EN_SHIFT,		\
+	.volt_cr		= BUCK ## _index ## OUT_DVS0,	\
+	.alt_volt_cr		= BUCK ## _index ## OUT_DVS1,	\
+	.limits			= 0,				\
+	.pd_reg			= BUCK ## _index ## CTRL,	\
+	.pd_val			= BUCK_AD_BIT,			\
+}
+
+#define DEFINE_BUCK456(_index) {				\
+	.name			= "buck" # _index,		\
+	.en_cr			= BUCK ## _index ## CTRL,	\
+	.en_shift		= BUCK_EN_SHIFT,		\
+	.volt_cr		= BUCK ## _index ## OUT,	\
+	.limits			= 1,				\
+	.pd_reg			= BUCK ## _index ## CTRL,	\
+	.pd_val			= BUCK_AD_BIT,			\
+}
+
+#define DEFINE_LDO(_index, _limits) {				\
+	.name			= "ldo" # _index,		\
+	.en_cr			= LDO ## _index ## CTRL,	\
+	.en_shift		= LDO_EN_SHIFT,			\
+	.volt_cr		= LDO ## _index ## CTRL,	\
+	.limits			= _limits,			\
+	.pd_reg			= LDO_AD_CTRL,			\
+	.pd_val			= LDO ## _index ## _AD_BIT,	\
+}
+
+static uint16_t ldo1_volt_table[8] = {
+	1600,
+	1700,
+	1800,
+	1900,
+	3000,
+	3100,
+	3200,
+	3300,
+};
+
+static uint16_t *volt_tables[] = {
+	NULL,
+	NULL,
+	ldo1_volt_table,
+	NULL,
+	NULL,
+	NULL,
+};
+
+/* Table of Regulators in PMIC SoC */
+static struct regul_struct regul_table[] = {
+	[PCA9450_BUCK1] = DEFINE_BUCK123(1),
+	[PCA9450_BUCK2] = DEFINE_BUCK123(2),
+	[PCA9450_BUCK3] = DEFINE_BUCK123(3),
+	[PCA9450_BUCK4] = DEFINE_BUCK456(4),
+	[PCA9450_BUCK5] = DEFINE_BUCK456(5),
+	[PCA9450_BUCK6] = DEFINE_BUCK456(6),
+	[PCA9450_LDO1] = DEFINE_LDO(1, 2),
+	[PCA9450_LDO2] = DEFINE_LDO(2, 3),
+	[PCA9450_LDO3] = DEFINE_LDO(3, 4),
+	[PCA9450_LDO4] = DEFINE_LDO(4, 4),
+	[PCA9450_LDO5] = DEFINE_LDO(5, 5),
+};
+
+static inline const struct regulator_limits *get_limits(const struct regul_struct *regul)
+{
+	return &pca9450_regulator_limits[regul->limits];
+}
+
+static inline uint8_t mv_to_regval(const struct regulator_limits *limits, uint16_t mv)
+{
+	return (mv * 10 - limits->min) / limits->step;
+}
+
+static inline uint16_t regval_to_mv(const struct regulator_limits *limits, uint8_t regval)
+{
+	uint16_t mv = (regval & limits->mask) * limits->step + limits->min;
+
+	if (mv > limits->max)
+		mv = limits->max;
+	return mv / 10;
+}
+
+TEE_Result pca9450_register_read(struct pmic_handle_s *pmic,
+				 uint16_t register_id, uint8_t *value)
+{
+	int res = stm32_i2c_read_write_membyte(pmic->pmic_i2c_handle,
+					       pmic->pmic_i2c_addr,
+					       register_id, value,
+					       false /* !write */);
+	if (res) {
+		EMSG("Failed to read reg:0x%04x", register_id);
+		return TEE_ERROR_COMMUNICATION;
+	}
+
+	FMSG("REG:0x%04x v=0x%02x", register_id, *value);
+
+	return TEE_SUCCESS;
+}
+
+TEE_Result pca9450_register_write(struct pmic_handle_s *pmic,
+				  uint16_t register_id, uint8_t value)
+{
+	int ret;
+
+	ret = stm32_i2c_read_write_membyte(pmic->pmic_i2c_handle,
+					   pmic->pmic_i2c_addr,
+					   register_id, &value,
+					   true /* write */);
+	if (ret) {
+		EMSG("Failed to write reg:0x%4x: %d", register_id, ret);
+		return TEE_ERROR_COMMUNICATION;
+	}
+
+	FMSG("REG:0x%04x written v=0x%02x", register_id, value);
+
+	return TEE_SUCCESS;
+}
+
+TEE_Result pca9450_register_update(struct pmic_handle_s *pmic,
+				   uint16_t register_id, uint8_t value,
+				   uint8_t mask)
+{
+	TEE_Result res;
+	uint8_t val;
+
+	res = pca9450_register_read(pmic, register_id, &val);
+	if (res)
+		return res;
+
+	val = (val & ~mask) | (value & mask);
+
+	FMSG("REG:0x%04x v=0x%02x mask=0x%02x -> 0x%02x", register_id, value,
+	     mask, val);
+
+	return pca9450_register_write(pmic, register_id, val);
+}
+
+TEE_Result pca9450_regulator_set_state(struct pmic_handle_s *pmic,
+				       uint8_t id, bool enable)
+{
+	const struct regul_struct *regul = &regul_table[id];
+	const uint8_t en_mask = REG_ENABLE_MASK << regul->en_shift;
+	const uint8_t en_val = (enable ? REG_ON : REG_OFF) << regul->en_shift;
+
+	return pca9450_register_update(pmic, regul->en_cr, en_val, en_mask);
+}
+
+TEE_Result pca9450_regulator_get_state(struct pmic_handle_s *pmic,
+				       uint8_t id, bool *enabled)
+{
+	TEE_Result res;
+	const struct regul_struct *regul = &regul_table[id];
+	uint8_t val;
+
+	res = pca9450_register_read(pmic, regul->en_cr, &val);
+	if (res)
+		return res;
+
+	*enabled = !!(val & (REG_ENABLE_MASK << regul->en_shift));
+
+	return TEE_SUCCESS;
+}
+
+TEE_Result pca9450_regulator_levels_mv(struct pmic_handle_s *pmic __unused,
+				       uint8_t id, const uint16_t **levels,
+				       size_t *levels_count)
+{
+	const struct regul_struct *regul = &regul_table[id];
+
+	if (!regul)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	if (levels_count)
+		*levels_count = regul->volt_table_size;
+	if (levels)
+		*levels = regul->volt_table;
+
+	return TEE_SUCCESS;
+}
+
+TEE_Result pca9450_regulator_get_voltage(struct pmic_handle_s *pmic,
+					 uint8_t id, uint16_t *val)
+{
+	TEE_Result res;
+	const struct regul_struct *regul = &regul_table[id];
+	const struct regulator_limits *limits = get_limits(regul);
+	uint8_t mask = limits->mask;
+	uint8_t idx;
+
+	if (regul->volt_table_size == 0)
+		return TEE_ERROR_GENERIC;
+
+	res = pca9450_register_read(pmic, regul->volt_cr, &idx);
+	if (res)
+		return res;
+
+	idx &= mask;
+	if (idx > regul->volt_table_size)
+		idx = regul->volt_table_size - 1;
+
+	*val = regul->volt_table[idx];
+	return TEE_SUCCESS;
+}
+
+static size_t voltage_to_index(const struct regul_struct *regul,
+			       uint16_t millivolts)
+{
+	size_t i;
+
+	assert(regul->volt_table);
+	for (i = 0; i < regul->volt_table_size; i++)
+		if (regul->volt_table[i] == millivolts)
+			return i;
+
+	return VOLTAGE_INDEX_INVALID;
+}
+
+TEE_Result pca9450_regulator_set_voltage(struct pmic_handle_s *pmic,
+					 uint8_t id, uint16_t mv)
+{
+	const struct regul_struct *regul = &regul_table[id];
+	const struct regulator_limits *limits = get_limits(regul);
+	size_t index;
+	uint8_t mask = limits->mask;
+
+	if (mv * 10 > limits->max || mv * 10 < limits->min)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	index = voltage_to_index(regul, mv);
+	if (index == VOLTAGE_INDEX_INVALID)
+		return TEE_ERROR_BAD_PARAMETERS;
+
+	return pca9450_register_update(pmic, regul->volt_cr,
+				       index, mask);
+}
+
+TEE_Result pca9450_regulator_get_prop(struct pmic_handle_s *pmic, uint8_t id,
+				      enum pca9450_prop_id prop, uint8_t *arg)
+{
+	TEE_Result res;
+	const struct regul_struct *regul = &regul_table[id];
+	uint8_t val;
+
+	IMSG("%s: get prop 0x%04x", regul->name, prop);
+
+	switch (prop) {
+	case PCA9450_PULL_DOWN:
+		res = pca9450_register_read(pmic, regul->pd_reg, &val);
+		if (res)
+			return res;
+		*arg = val;
+		break;
+	default:
+		EMSG("Invalid prop 0x%04x", prop);
+		panic();
+	}
+
+	return res;
+}
+
+TEE_Result pca9450_regulator_set_prop(struct pmic_handle_s *pmic, uint8_t id,
+				      enum pca9450_prop_id prop, uint8_t arg)
+{
+	const struct regul_struct *regul = &regul_table[id];
+
+	IMSG("%s: set prop 0x%04x arg=%u", regul->name, prop, arg);
+
+	switch (prop) {
+	case PCA9450_PULL_DOWN:
+		return pca9450_register_update(pmic, regul->pd_reg,
+					       arg ? regul->pd_val : 0,
+					       regul->pd_val);
+	default:
+		EMSG("Invalid prop 0x%04x", prop);
+		panic();
+	}
+
+	return TEE_SUCCESS;
+}
+
+void pca9450_dump_regulators(struct pmic_handle_s *pmic)
+{
+	size_t i;
+
+	assert(pmic);
+
+	for (i = 0; i < ARRAY_SIZE(regul_table); i++) {
+		uint16_t val;
+		bool state;
+		char __maybe_unused const *name;
+
+		if (!regul_table[i].volt_cr)
+			continue;
+
+		pca9450_regulator_get_voltage(pmic, i, &val);
+		pca9450_regulator_get_state(pmic, i, &state);
+
+		name = regul_table[i].name;
+		IMSG("PMIC regul %s: %s, %dmv", name,
+		     state ? "EN" : "DIS", val);
+	}
+}
+
+TEE_Result pca9450_get_chip_id(struct pmic_handle_s *pmic, uint8_t *val)
+{
+	return pca9450_register_read(pmic, DEVICE_ID, val);
+}
+
+/*
+ *
+ * Low Power
+ *
+ */
+TEE_Result pca9450_lp_set_state(struct pmic_handle_s *pmic, uint8_t id,
+				bool enable)
+{
+	const struct regul_struct *regul = &regul_table[id];
+	const uint8_t en_mask = REG_ENABLE_MASK << regul->en_shift;
+	const uint8_t en_val = (enable ? REG_STBY_ON : REG_STBY_OFF) << regul->en_shift;
+
+	return pca9450_register_update(pmic, regul->en_cr, en_val, en_mask);
+}
+
+TEE_Result pca9450_lp_set_voltage(struct pmic_handle_s *pmic, uint8_t id,
+				  uint16_t mv)
+{
+	TEE_Result res;
+	const struct regul_struct *regul = &regul_table[id];
+	const struct regulator_limits *limits = get_limits(regul);
+	size_t index;
+
+	if (!regul->alt_volt_cr)
+		return TEE_SUCCESS;
+	if (!regul->volt_table_size)
+		return TEE_SUCCESS;
+
+	index = voltage_to_index(regul, mv);
+	if (index == VOLTAGE_INDEX_INVALID)
+		return TEE_ERROR_GENERIC;
+
+	res = pca9450_register_update(pmic, regul->alt_volt_cr,
+				      index, limits->mask);
+	if (res)
+		return res;
+
+	res = pca9450_register_update(pmic, regul->en_cr, 0*BUCK_DVS_CTRL, BUCK_DVS_CTRL);
+	return res;
+}
+
+/*
+ *
+ * Interrupt handling
+ *
+ */
+TEE_Result pca9450_set_irq_mask(struct pmic_handle_s *pmic, uint8_t num,
+				bool state)
+{
+	uint8_t mask = BIT(num);
+	uint8_t val = state ? mask : 0;
+
+	return pca9450_register_update(pmic, INT1_MSK, val, mask);
+}
+
+enum itr_return pca9450_handle_irq(struct pmic_handle_s *pmic)
+{
+	enum itr_return res = ITRR_NONE;
+	uint8_t val;
+
+	FMSG("PCA9450 irq handler");
+
+	if (pca9450_register_read(pmic, INT1, &val))
+		panic();
+
+	if (val) {
+		int it_id;
+
+		FMSG("PCA9450 irq pending irq=0x%02x", val);
+
+		pmic->irq_count++;
+
+		for (it_id = 0; it_id < 8; it_id++) {
+			if (val & BIT(it_id)) {
+				if (pca9450_irq_callback(pmic, it_id) == ITRR_HANDLED)
+					res = ITRR_HANDLED;
+			}
+		}
+	}
+
+	return res;
+}
+
+void pca9450_init(void)
+{
+	size_t id;
+
+	for (id = 0; id < ARRAY_SIZE(regul_table); id++) {
+		struct regul_struct *regul = &regul_table[id];
+		const struct regulator_limits *limits = get_limits(regul);
+		size_t num_voltages = limits->mask + 1;
+		size_t idx;
+		uint16_t *volt_table = volt_tables[regul->limits];
+
+		if (!volt_table)
+			volt_table = calloc(num_voltages, sizeof(*volt_table));
+		if (!volt_table) {
+			EMSG("Failed to allocate volt_table for %s\n",
+			     regul->name);
+			panic();
+		}
+
+		FMSG("%s@%d: %s volt_table=%p\n", __func__, __LINE__,
+		     regul->name, volt_table);
+
+		for (idx = 0; idx < num_voltages; idx++) {
+			/* skip tables that have already been set up */
+			if (!volt_table[idx]) {
+				int ret;
+
+				ret = regval_to_mv(limits, idx);
+				if (ret < 0) {
+					EMSG("Regulator reg value %08zx out of range 0..%u\n",
+					     idx, limits->mask + 1U);
+					panic();
+				}
+				if ((uint16_t)ret > limits->max)
+					break;
+				volt_table[idx] = ret;
+			}
+			FMSG("%s@%d: %s[%zu]=%umV\n", __func__, __LINE__,
+			     regul->name, idx, volt_table[idx]);
+		}
+		regul->volt_table = volt_table;
+		regul->volt_table_size = idx;
+		IMSG("%s@%d: %s volt_table=%p %zu voltages [%u..%u]mV\n",
+		     __func__, __LINE__, regul->name, regul->volt_table,
+		     regul->volt_table_size, volt_table[0], volt_table[idx - 1]);
+	}
+}
