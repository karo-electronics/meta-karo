+#define PMIC_I2C_TRIALS			1
+#define PMIC_I2C_TIMEOUT_BUSY_MS	5
+
+/* Mutex for protecting PMIC accesses */
+static struct mutex pmic_mu = MUTEX_INITIALIZER;
+
+/*
+ * Low power configurations:
+ *
+ * STM32_PM_DEFAULT
+ *   "default" sub nodes in device-tree
+ *   is applied at probe, and re-applied at PM resume.
+ *   should support STOP1, LP-STOP1, STOP2, LP-STOP2
+ *
+ * STM32_PM_LPLV
+ *   "lplv" sub nodes in device-tree
+ *   should support STOP1, LPLV-STOP1, STOP2, LPLV-STOP2
+ *
+ * STM32_PM_STANDBY
+ *   "standby" sub nodes in device-tree
+ *   should support STANDBY1-DDR-SR
+ *   is applied in pm suspend call back
+ *
+ * STM32_PM_OFF
+ *   "off" sub nodes in device-tree
+ *   should support STANDBY-DDR-OFF mode
+ *   and should be applied before shutdown
+ *
+ */
+#define STM32_PM_DEFAULT		0
+#define STM32_PM_LPLV			1
+#define STM32_PM_STANDBY		2
+#define STM32_PM_OFF			3
+#define STM32_PM_NB_SOC_MODES		4
+
+static const char *plat_get_lp_mode_name(int mode __unused)
+{
+	switch (mode) {
+	case STM32_PM_DEFAULT:
+		return "default";
+	case STM32_PM_LPLV:
+		return "lplv";
+	case STM32_PM_STANDBY:
+		return "standby";
+	case STM32_PM_OFF:
+		return "off";
+	default:
+		EMSG("Invalid lp mode %d", mode);
+		panic();
+	}
+}
+
+#define PCA9450_LP_STATE_OFF		BIT(0)
+#define PCA9450_LP_STATE_ON		BIT(1)
+#define PCA9450_LP_STATE_UNMODIFIED	BIT(2)
+#define PCA9450_LP_STATE_SET_VOLT	BIT(3)
+
+struct regu_handle_s {
+	struct pmic_handle_s *pmic;
+	struct regul_desc desc;
+	uint32_t id;
+	uint16_t lp_mv[STM32_PM_NB_SOC_MODES];
+	uint8_t lp_state[STM32_PM_NB_SOC_MODES];
+};
+
+static TEE_Result pmic_set_state(const struct regul_desc *desc, bool enable)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+
+	FMSG("%u:%s: set state to %u", id, desc->node_name, enable);
+
+	return pca9450_regulator_set_state(pmic, id, enable);
+}
+
+static TEE_Result pmic_get_state(const struct regul_desc *desc, bool *enabled)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+
+	FMSG("%u:%s: get state\n", id, desc->node_name);
+
+	return pca9450_regulator_get_state(pmic, id, enabled);
+}
+
+static TEE_Result pmic_get_voltage(const struct regul_desc *desc, uint16_t *mv)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+	uint16_t val;
+	TEE_Result res;
+
+	res = pca9450_regulator_get_voltage(pmic, id, &val);
+	if (res)
+		return res;
+
+	*mv = val;
+
+	FMSG("%s: get volt %u.%03u mV", desc->node_name, val / 1000U, val % 1000U);
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result pmic_verify_voltage(const struct regul_desc *desc, uint16_t mv)
+{
+	TEE_Result res;
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+	const uint16_t *levels;
+	size_t count;
+	size_t n;
+
+	res = pca9450_regulator_levels_mv(pmic, id, &levels,
+					  &count);
+	if (res)
+		return res;
+
+	for (n = 0; n < count; n++)
+		if (levels[n] == mv)
+			return TEE_SUCCESS;
+
+	return TEE_ERROR_GENERIC;
+
+}
+
+static TEE_Result pmic_set_voltage(const struct regul_desc *desc, uint16_t mv)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+	TEE_Result res;
+
+	FMSG("%s: set volt to %u.%03u mV", desc->node_name,
+	     mv / 1000U, mv % 1000U);
+
+	res = pca9450_regulator_set_voltage(pmic, id, mv);
+	return res;
+}
+
+static TEE_Result pmic_list_voltages(const struct regul_desc *desc,
+				     uint16_t **levels, size_t *count)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+
+	FMSG("%s: list volt", desc->node_name);
+
+	return pca9450_regulator_levels_mv(pmic, id, (const uint16_t **)levels,
+					   count);
+}
+
+/*
+ * Set flag from regulator framework.
+ * Only handle regultor standard flags
+ */
+static TEE_Result pmic_set_flag(const struct regul_desc *desc, uint16_t flag)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+	TEE_Result res = TEE_SUCCESS;
+
+	FMSG("%s: set_flag 0x%04x", desc->node_name, flag);
+
+	switch (flag) {
+	case REGUL_PULL_DOWN:
+		res = pca9450_regulator_set_prop(pmic, id,
+						 PCA9450_PULL_DOWN, 0);
+		break;
+	default:
+		EMSG("Invalid flag 0x%04x", flag);
+		panic();
+	}
+
+	return res;
+}
+
+static void driver_lock(const struct regul_desc *desc __unused)
+{
+	if (thread_get_id_may_fail() != THREAD_ID_INVALID)
+		mutex_lock(&pmic_mu);
+}
+
+static void driver_unlock(const struct regul_desc *desc __unused)
+{
+	if (thread_get_id_may_fail() != THREAD_ID_INVALID)
+		mutex_unlock(&pmic_mu);
+}
+
+static TEE_Result __maybe_unused
+regu_prepare_suspend(const struct regul_desc *desc, uint8_t mode)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+	uint8_t state = regu->lp_state[mode];
+	uint16_t mv = regu->lp_mv[mode];
+	TEE_Result res;
+
+	IMSG("%s: suspend state:%#08x %u mv", desc->node_name,
+	     state, mv);
+
+	if (state & PCA9450_LP_STATE_UNMODIFIED)
+		return TEE_SUCCESS;
+
+	if (state & PCA9450_LP_STATE_OFF) {
+		res = pca9450_lp_set_state(pmic, id, false);
+		if (res)
+			return res;
+	}
+
+	if (state & PCA9450_LP_STATE_ON) {
+		res = pca9450_lp_set_state(pmic, id, true);
+		if (res)
+			return res;
+
+		if (state & PCA9450_LP_STATE_SET_VOLT) {
+			res = pca9450_lp_set_voltage(pmic, id, mv);
+			if (res)
+				return res;
+		}
+	}
+
+	return TEE_SUCCESS;
+}
+
+static const struct regul_ops pmic_ops = {
+	.set_state = pmic_set_state,
+	.get_state = pmic_get_state,
+	.set_voltage = pmic_set_voltage,
+	.get_voltage = pmic_get_voltage,
+	.list_voltages = pmic_list_voltages,
+	.set_flag = pmic_set_flag,
+	.lock = driver_lock,
+	.unlock = driver_unlock,
+};
+
+#define DEFINE_REGU(name) { \
+	.node_name = name, \
+	.driver_data = NULL, \
+	.ops = &pmic_ops, \
+	.ramp_delay_uv_per_us = 2200, \
+	.enable_ramp_delay_us = 1000, \
+}
+
+static const struct regul_desc pmic_reguls[] = {
+	[PCA9450_BUCK1] = DEFINE_REGU("buck1"),
+	[PCA9450_BUCK2] = DEFINE_REGU("buck2"),
+	[PCA9450_BUCK3] = DEFINE_REGU("buck3"),
+	[PCA9450_BUCK4] = DEFINE_REGU("buck4"),
+	[PCA9450_BUCK5] = DEFINE_REGU("buck5"),
+	[PCA9450_BUCK6] = DEFINE_REGU("buck6"),
+	[PCA9450_LDO1] = DEFINE_REGU("ldo1"),
+	[PCA9450_LDO2] = DEFINE_REGU("ldo2"),
+	[PCA9450_LDO3] = DEFINE_REGU("ldo3"),
+	[PCA9450_LDO4] = DEFINE_REGU("ldo4"),
+	[PCA9450_LDO5] = DEFINE_REGU("ldo5"),
+};
+DECLARE_KEEP_PAGER(pmic_reguls);
+
+struct regul_property {
+	const char *name;
+	uint16_t prop;
+};
+
+static const struct regul_property prop_table[] = {
+	{
+		.name = "wdog-b-reset",
+		.prop = PCA9450_WDOG_B_RESET,
+	},
+	{
+		.name = "pmic-rst-b",
+		.prop = PCA9450_PMIC_RST_B,
+	},
+};
+
+static TEE_Result __unused pca9450_set_prop(const struct regul_desc *desc,
+					    enum pca9450_prop_id prop, uint16_t value)
+{
+	const struct regu_handle_s *regu = desc->driver_data;
+	struct pmic_handle_s *pmic = regu->pmic;
+	uint32_t id = regu->id;
+
+	assert(desc);
+
+	FMSG("%s: set_prop 0x%x val=%u\n", desc->node_name, prop, value);
+
+	return pca9450_regulator_set_prop(pmic, id, prop, value);
+}
+
+static TEE_Result parse_properties(const void *fdt, int node,
+				   struct pmic_handle_s *pmic)
+
+{
+	const struct regul_property *p;
+
+	for (p = prop_table; p < (prop_table + ARRAY_SIZE(prop_table)); p++) {
+		const char *val;
+		int len;
+		int arg = -1;
+		TEE_Result res;
+
+		switch (p->prop) {
+		case PCA9450_WDOG_B_RESET:
+			// fallthrough
+		case PCA9450_PMIC_RST_B:
+			val = fdt_get_string(fdt, node, &len);
+
+			if (!val)
+				arg = 0;
+			else if (strcmp(val, "all") == 0)
+				arg = 3;
+			else if (strcmp(val, "cold") == 0)
+				arg = 2;
+			else if (strcmp(val, "warm") == 0)
+				arg = 1;
+			else if (strcmp(val, "disabled") == 0)
+				arg = 0;
+			else
+				EMSG("%s: Invalid %s property value: '%s'",
+				     fdt_get_name(fdt, node, NULL), p->name, val);
+			if (arg == -1)
+				continue;
+			if (p->prop == PCA9450_WDOG_B_RESET)
+				res = pca9450_register_update(pmic, RESET_CTRL,
+							       WDOG_B_CFG_MSK,
+							       arg << WDOG_B_CFG_SHIFT);
+			else
+				res = pca9450_register_update(pmic, RESET_CTRL,
+							       PMIC_RST_CFG_MSK,
+							       arg << PMIC_RST_CFG_SHIFT);
+			if (res)
+				return res;
+			break;
+
+		default:
+			FMSG("%s: Ignoring property '%s'",
+			     fdt_get_name(fdt, node, NULL), p->name);
+		}
+	}
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result parse_low_power_mode(const void *fdt,
+				 const struct regul_desc *desc,
+				 int node, int mode)
+{
+	struct regu_handle_s *regu = (void *)desc->driver_data;
+	const fdt32_t *cuint;
+
+	regu->lp_state[mode] = 0;
+
+	if (fdt_getprop(fdt, node, "regulator-off-in-suspend", NULL)) {
+		FMSG("%s: mode:%d OFF", desc->node_name, mode);
+		regu->lp_state[mode] |= PCA9450_LP_STATE_OFF;
+	} else if (fdt_getprop(fdt, node, "regulator-on-in-suspend", NULL)) {
+		FMSG("%s: mode:%d ON", desc->node_name, mode);
+		regu->lp_state[mode] |= PCA9450_LP_STATE_ON;
+	} else {
+		regu->lp_state[mode] |= PCA9450_LP_STATE_UNMODIFIED;
+	}
+
+	cuint = fdt_getprop(fdt, node, "regulator-suspend-microvolt", NULL);
+	if (cuint) {
+		uint16_t mv = fdt32_to_cpu(*cuint) / 1000;
+		TEE_Result res;
+
+		IMSG("%s: mode:%d suspend mv=%u", desc->node_name,
+		     mode, mv);
+
+		res = pmic_verify_voltage(desc, mv);
+		if (res != TEE_SUCCESS) {
+			EMSG("Invalid suspend voltage %u", mv);
+			return res;
+		}
+		regu->lp_state[mode] |= PCA9450_LP_STATE_SET_VOLT;
+		regu->lp_mv[mode] = mv;
+	}
+	return TEE_SUCCESS;
+}
+
+static TEE_Result parse_low_power_modes(const void *fdt,
+					const struct regul_desc *desc, int node)
+{
+	int mode;
+
+	for (mode = 0; mode < STM32_PM_NB_SOC_MODES; mode++) {
+		const char *lp_mode_name = plat_get_lp_mode_name(mode);
+
+		if (lp_mode_name) {
+			int n;
+			TEE_Result res;
+
+			/* Get the configs from regulator_state_node subnode */
+			n = fdt_subnode_offset(fdt, node, lp_mode_name);
+			if (n >= 0) {
+				res = parse_low_power_mode(fdt, desc, n, mode);
+				if (res)
+					return res;
+			}
+		}
+	}
+	return TEE_SUCCESS;
+}
+
+#ifdef CFG_PM
+static TEE_Result pca9450_regu_pm(enum pm_op op, uint32_t pm_hint,
+				  const struct pm_callback_handle *pm_handle)
+{
+	struct regul_desc *desc = (struct regul_desc *)pm_handle->handle;
+	TEE_Result res;
+	unsigned int pwrlvl = PM_HINT_PLATFORM_STATE(pm_hint);
+	uint8_t mode;
+
+	if (op == PM_OP_SUSPEND) {
+		/* configure PMIC level according MAX PM domain OFF */
+		switch (pwrlvl) {
+		case PM_D1_LEVEL:
+		case PM_D2_LEVEL:
+			mode = STM32_PM_LPLV;
+			break;
+		case PM_D2_LPLV_LEVEL:
+			mode = STM32_PM_STANDBY;
+			break;
+		case PM_MAX_LEVEL:
+			mode = STM32_PM_OFF;
+			break;
+		default:
+			mode = STM32_PM_DEFAULT;
+			break;
+		}
+	} else if (op == PM_OP_RESUME) {
+		mode = STM32_PM_DEFAULT;
+	} else {
+		EMSG("INVALID PM OP 0x%08x", op);
+		panic();
+	}
+
+	res = regu_prepare_suspend(desc, mode);
+	return res;
+}
+#endif
+
+static TEE_Result register_pmic_regulator(const void *fdt,
+					  struct pmic_handle_s *pmic,
+					  const char *regu_name, int node)
+{
+	TEE_Result res;
+	struct regu_handle_s *regu;
+	struct regul_desc *desc;
+	size_t id;
+
+	IMSG("PCA9450 register %s", regu_name);
+
+	for (id = 0; id < ARRAY_SIZE(pmic_reguls); id++)
+		if (!strcmp(pmic_reguls[id].node_name, regu_name))
+			break;
+
+	assert(id < ARRAY_SIZE(pmic_reguls));
+
+	regu = calloc(1, sizeof(*regu));
+	if (!regu)
+		panic();
+
+	regu->pmic = pmic;
+	regu->id = id;
+	desc = &regu->desc;
+
+	memcpy(desc, pmic_reguls + id, sizeof(*desc));
+	desc->driver_data = regu;
+
+	res = regulator_register(desc, node);
+	if (res) {
+		EMSG("Failed to register %s", regu_name);
+		goto out;
+	}
+
+	res = parse_low_power_modes(fdt, desc, node);
+	if (res) {
+		EMSG("Failed to parse low power modes for %s", regu_name);
+		goto out;
+	}
+
+	res = regu_prepare_suspend(desc, STM32_PM_DEFAULT);
+	if (res) {
+		EMSG("Failed to prepare suspend mode for %s", regu_name);
+		goto out;
+	}
+
+#ifdef CFG_PM
+	register_pm_core_service_cb(pca9450_regu_pm, desc, desc->node_name);
+#endif
+
+	return TEE_SUCCESS;
+
+out:
+	free(regu);
+	return res;}
+
+static TEE_Result parse_regulator_fdt_nodes(const void *fdt, int node,
+					    struct pmic_handle_s *pmic)
+{
+	int regulators_node;
+	int regu_node;
+
+	regulators_node = fdt_subnode_offset(fdt, node, "regulators");
+	if (regulators_node < 0)
+		panic();
+
+	fdt_for_each_subnode(regu_node, fdt, regulators_node) {
+		TEE_Result res = TEE_ERROR_GENERIC;
+		int status = _fdt_get_status(fdt, regu_node);
+		const char *regu_name;
+
+		assert(status >= 0);
+		if (status == DT_STATUS_DISABLED)
+			continue;
+
+		regu_name = fdt_get_name(fdt, regu_node, NULL);
+		assert(regu_name);
+
+		res = register_pmic_regulator(fdt, pmic, regu_name, regu_node);
+		if (res) {
+			EMSG("Failed to register %s", regu_name);
+			return res;
+		}
+	}
+
+	return TEE_SUCCESS;
+}
+
+#ifdef CFG_STM32_PWR_IRQ
+
+enum itr_return pca9450_irq_callback(struct pmic_handle_s *pmic, uint8_t it_id)
+{
+	struct pmic_it_handle_s *prv = NULL;
+
+	FMSG("PCA9450 it id %d", (int)it_id);
+
+	SLIST_FOREACH(prv, &pmic->it_list, link)
+		if (prv->pmic_it == it_id) {
+			FMSG("PCA9450 send notif %u", prv->notif_id);
+
+			notif_send_it(prv->notif_id);
+
+			return ITRR_HANDLED;
+		}
+
+	return ITRR_NONE;
+}
+
+static enum itr_return pca9450_irq_handler(struct itr_handler *handler)
+{
+	struct pmic_handle_s *pmic = handler->data;
+
+	FMSG("PCA9450 irq");
+
+	return pca9450_handle_irq(pmic);
+}
+
+static TEE_Result initialize_pca9450_irq(const void *fdt, int node,
+					 struct pmic_handle_s *pmic)
+{
+	TEE_Result res;
+	struct itr_handler *hdl;
+	const fdt32_t *cuint;
+	const uint32_t *notif_ids;
+	int nb_notif;
+
+	IMSG("Init pca9450 irq");
+
+	SLIST_INIT(&pmic->it_list);
+
+	cuint = fdt_getprop(fdt, node, "st,wakeup-pin-number", NULL);
+	if (cuint) {
+		size_t it = fdt32_to_cpu(*cuint) - 1;
+
+		res = stm32mp25_pwr_itr_alloc_add(it, pca9450_irq_handler,
+						  PWR_WKUP_FLAG_FALLING |
+						  PWR_WKUP_FLAG_THREADED,
+						  pmic, &hdl);
+		if (res)
+			return res;
+
+		stm32mp25_pwr_itr_enable(hdl->it);
+	}
+
+	notif_ids = fdt_getprop(fdt, node, "st,notif-it-id", &nb_notif);
+	if (nb_notif > 0) {
+		struct pmic_it_handle_s *prv;
+		unsigned int i;
+		const uint32_t *pmic_its;
+		int nb_it;
+
+		pmic_its = fdt_getprop(fdt, node, "st,pmic-it-id", &nb_it);
+		if (!pmic_its)
+			return TEE_ERROR_ITEM_NOT_FOUND;
+
+		if (nb_it != nb_notif)
+			panic("st,notif-it-id incorrect description");
+
+		for (i = 0; i < (nb_notif / sizeof(uint32_t)); i++) {
+			uint8_t pmic_it;
+
+			prv = calloc(1, sizeof(*prv));
+			if (!prv)
+				panic("pmic: Could not allocate pmic it");
+
+			pmic_it = fdt32_to_cpu(pmic_its[i]);
+
+			prv->pmic_it = pmic_it;
+			prv->notif_id = fdt32_to_cpu(notif_ids[i]);
+
+			SLIST_INSERT_HEAD(&pmic->it_list, prv, link);
+
+			/* Enable requested interrupt */
+			if (pca9450_set_irq_mask(pmic, pmic_it, false))
+				return TEE_ERROR_GENERIC;
+
+			IMSG("PCA9450 forwards pmic_it:%u as notif:%u",
+			     prv->pmic_it, prv->notif_id);
+		}
+	}
+
+	/* Unmask all over-current interrupts */
+	res = pca9450_register_write(pmic, INT1_MSK, 0x00);
+
+	return res;
+}
+#endif
+
+static void initialize_pca9450_i2c(const void *fdt, int node,
+				   struct pmic_handle_s *pmic,
+				   struct i2c_handle_s *i2c)
+{
+	const fdt32_t *cuint = NULL;
+	uint32_t pmic_i2c_addr;
+
+	cuint = fdt_getprop(fdt, node, "reg", NULL);
+	if (!cuint)
+		panic("PMIC configuration failed on reg property");
+
+	pmic_i2c_addr = fdt32_to_cpu(*cuint) << 1;
+	if (pmic_i2c_addr > UINT16_MAX)
+		panic("PMIC configuration failed on i2c address translation");
+
+	if (!stm32_i2c_is_device_ready(i2c, pmic_i2c_addr,
+				       PMIC_I2C_TRIALS,
+				       PMIC_I2C_TIMEOUT_BUSY_MS)) {
+		panic("PCA9450 I2C init failed");
+	}
+
+	pmic->pmic_i2c_handle = i2c;
+	pmic->pmic_i2c_addr = pmic_i2c_addr;
+}
+
+/*
+ * PMIC and resource initialization
+ */
+static void initialize_pca9450(const void *fdt, int node,
+			       struct pmic_handle_s *pmic,
+			       struct i2c_handle_s *i2c)
+{
+	uint8_t chip_id;
+	const char *variant;
+
+	FMSG("Initialize pca9450");
+
+	initialize_pca9450_i2c(fdt, node, pmic, i2c);
+
+	if (pca9450_get_chip_id(pmic, &chip_id))
+		panic("Failed to access PMIC");
+
+	switch ((chip_id & CHIP_ID_MASK) >> CHIP_ID_SHIFT) {
+	case CHIP_ID_PCA9450A:
+		variant = "A";
+		break;
+	case CHIP_ID_PCA9450BC:
+		variant = "B/C";
+		break;
+	default:
+		EMSG("Unsupported PCA9450 chip variant 0x%02x", chip_id);
+		panic();
+	}
+	IMSG("PMIC PCA9450%s 0x%02x", variant, chip_id);
+
+	pca9450_init();
+
+	pca9450_register_write(pmic, BUCK123_DVS, 0x00);
+
+	pca9450_dump_regulators(pmic);
+}
+
+static TEE_Result pmic_pca9450_probe(const void *fdt, int node,
+				     const void *compat_data __unused)
+{
+	struct i2c_handle_s *i2c = NULL;
+	TEE_Result res = TEE_ERROR_GENERIC;
+	struct pmic_handle_s *pmic = NULL;
+
+	FMSG("Probe pca9450");
+
+	res = i2c_dt_get_by_subnode(fdt, node, &i2c);
+	if (res)
+		return res;
+
+	pmic = calloc(1, sizeof(*pmic));
+	if (!pmic)
+		panic();
+
+	initialize_pca9450(fdt, node, pmic, i2c);
+
+#ifdef CFG_STM32_PWR_IRQ
+	res = initialize_pca9450_irq(fdt, node, pmic);
+	if (res) {
+		free(pmic);
+		return res;
+	}
+#endif
+
+	res = parse_properties(fdt, node, pmic);
+	if (res) {
+		EMSG("Failed to parse properties");
+		free(pmic);
+		return res;
+	}
+
+	res = parse_regulator_fdt_nodes(fdt, node, pmic);
+	if (res)
+		panic();
+
+	return TEE_SUCCESS;
+}
+
+static const struct dt_device_match pmic_pca9450_match_table[] = {
+	{ .compatible = "nxp,pca9450" },
+	{ }
+};
+
+DEFINE_DT_DRIVER(pmic_pca9450_dt_driver) = {
+	.name = "pmic_pca9450",
+	.match_table = pmic_pca9450_match_table,
+	.probe = pmic_pca9450_probe,
+};
