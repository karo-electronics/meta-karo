Index: optee-os-txmp-2550/core/arch/arm/plat-stm32mp2/main.c
===================================================================
--- optee-os-txmp-2550.orig/core/arch/arm/plat-stm32mp2/main.c
+++ optee-os-txmp-2550/core/arch/arm/plat-stm32mp2/main.c
@@ -304,17 +304,20 @@ early_init_late(init_debug);
 bool stm32mp_supports_cpu_opp(uint32_t opp_id)
 {
 	static uint32_t part_number;
-	uint32_t otp = 0;
-	size_t bit_len = 0;
-	uint32_t id = 0;
+	uint32_t otp;
+	size_t bit_len;
+	uint32_t id;
 
-	if (stm32_bsec_find_otp_in_nvmem_layout("part_number_otp",
-						&otp, NULL, &bit_len))
-		return false;
-
-	if (stm32_bsec_read_otp(&part_number, otp))
-		return -1;
+	if (!part_number) {
+		if (stm32_bsec_find_otp_in_nvmem_layout("part_number_otp",
+						&otp, NULL, &bit_len)) {
+			EMSG("'part_number_otp' not found in DTB");
+			return false;
+		}
 
+		if (stm32_bsec_read_otp(&part_number, otp))
+			return false;
+	}
 	/* The bit 31 indicate support of 1.5GHz in RPN (variant d/f) */
 	if (part_number & BIT(31))
 		id = BIT(1);
